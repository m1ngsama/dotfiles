check_shell() {
  local file
  local -a bash_files=(
    scripts/check
    scripts/benchmark
    scripts/bootstrap
    scripts/install-chezmoi
    scripts/setup-nvim
    scripts/backup
    scripts/restore
    scripts/lib/safety.bash
    home/dot_config/ranger/executable_scope.sh
  )
  local -a sh_files=(
    home/executable_dot_xinitrc
    home/dot_xprofile
  )

  for file in "${bash_files[@]}"; do
    bash -n "$file" || return 1
  done
  for file in "${sh_files[@]}"; do
    sh -n "$file" || return 1
  done
}

check_shellcheck() {
  shellcheck \
    scripts/check \
    scripts/benchmark \
    scripts/bootstrap \
    scripts/install-chezmoi \
    scripts/setup-nvim \
    scripts/backup \
    scripts/restore \
    scripts/lib/safety.bash \
    home/executable_dot_xinitrc \
    home/dot_xprofile
}

check_tmux() (
  set -euo pipefail

  local socket="dotfiles-check-$$"
  local conf
  local first_snapshot
  local second_snapshot
  local terminal

  tmux -L "$socket" -f /dev/null new-session -d -s dotfiles-check
  trap 'tmux -L "$socket" kill-server >/dev/null 2>&1 || true' EXIT HUP INT TERM
  for conf in home/dot_config/tmux/*.conf; do
    tmux -L "$socket" source-file -n "$conf" >/dev/null
  done

  tmux -L "$socket" source-file "$repo_root/home/dot_config/tmux/tmux.conf"
  [[ $(tmux -L "$socket" show-options -gv prefix) == C-t ]]
  terminal=$(tmux -L "$socket" show-options -gv default-terminal)
  [[ $terminal == tmux-256color || $terminal == screen-256color ]]
  [[ $(tmux -L "$socket" show-options -gv @dotfiles_config_file) == "$repo_root/home/dot_config/tmux/tmux.conf" ]]
  tmux -L "$socket" list-keys -T prefix | grep -F 'lazygit is not installed' >/dev/null

  first_snapshot=$(
    tmux -L "$socket" show-options -sv terminal-features
    tmux -L "$socket" show-options -sv terminal-overrides
    tmux -L "$socket" show-options -gv status-left
  )
  tmux -L "$socket" source-file "$repo_root/home/dot_config/tmux/tmux.conf"
  second_snapshot=$(
    tmux -L "$socket" show-options -sv terminal-features
    tmux -L "$socket" show-options -sv terminal-overrides
    tmux -L "$socket" show-options -gv status-left
  )
  [[ $first_snapshot == "$second_snapshot" ]]
)

check_i3() {
  i3 -C -c "$repo_root/home/dot_config/i3/config" >/dev/null
}

check_ranger_scope() (
  set -uo pipefail

  local scope_parent
  local scope_root
  local scope_input
  local scope_stderr
  local scope_status

  scope_parent=${TMPDIR:-/tmp}
  scope_parent=$(cd -P -- "$scope_parent" && pwd -P)
  scope_root=$(mktemp -d "$scope_parent/dotfiles-scope.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$scope_root" "$scope_parent" dotfiles-scope.' EXIT HUP INT TERM
  scope_input="$scope_root/large.txt"

  # One byte above HIGHLIGHT_SIZE_MAX exercises the cross-platform stat path
  # and exits before any optional syntax highlighter is needed.
  dd if=/dev/zero bs=262144 count=1 2>/dev/null | LC_ALL=C tr '\000' x >"$scope_input"
  scope_stderr=$(
    home/dot_config/ranger/executable_scope.sh \
      "$scope_input" 80 24 "$scope_root/cache.jpg" False \
      2>&1 >/dev/null
  )
  scope_status=$?

  [[ $scope_status == 2 && -z $scope_stderr ]]
)

check_ranger_font_temp() (
  set -uo pipefail

  local font_parent
  local font_root
  local stub_dir
  local temp_dir
  local font_log
  local font_output
  local scope_stderr
  local scope_status

  font_parent=${TMPDIR:-/tmp}
  font_parent=$(cd -P -- "$font_parent" && pwd -P)
  font_root=$(mktemp -d "$font_parent/dotfiles-font-preview.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$font_root" "$font_parent" dotfiles-font-preview.' EXIT HUP INT TERM
  stub_dir="$font_root/bin"
  temp_dir="$font_root/tmp"
  font_log="$font_root/fontimage-path"
  mkdir -p -- "$stub_dir" "$temp_dir"

  printf '%s\n' \
    '#!/bin/sh' \
    'printf "%s\\n" application/opentype' \
    >"$stub_dir/file"
  # These variables intentionally expand later inside the generated stub.
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/bin/sh' \
    'output=' \
    'while [ "$#" -gt 0 ]; do' \
    '  if [ "$1" = -o ]; then shift; output=$1; break; fi' \
    '  shift' \
    'done' \
    '[ -n "$output" ] || exit 1' \
    'printf "%s\\n" "$output" > "$FONTIMAGE_LOG"' \
    'printf preview > "$output"' \
    >"$stub_dir/fontimage"
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/bin/sh' \
    'for argument do output=$argument; done' \
    'printf converted > "$output"' \
    >"$stub_dir/convert"
  chmod 0755 "$stub_dir/file" "$stub_dir/fontimage" "$stub_dir/convert"
  printf 'font fixture\n' >"$font_root/font.otf"

  scope_stderr=$(
    PATH="$stub_dir:/usr/bin:/bin" \
      TMPDIR="$temp_dir" \
      FONTIMAGE_LOG="$font_log" \
      home/dot_config/ranger/executable_scope.sh \
      "$font_root/font.otf" 80 24 "$font_root/cache.png" True \
      2>&1 >/dev/null
  )
  scope_status=$?
  [[ $scope_status == 6 && -z $scope_stderr ]] || return 1
  [[ -f $font_log && -f $font_root/cache.png ]] || return 1
  font_output=$(<"$font_log")
  [[ $font_output == "$temp_dir"/ranger-font-preview.*/preview.png ]] || return 1
  [[ ! -e ${font_output%/preview.png} ]] || return 1
)

check_ranger_media_previews() (
  set -uo pipefail

  local preview_parent
  local preview_root
  local stub_dir
  local minimal_dir
  local fixture
  local mode
  local output
  local stderr
  local status

  preview_parent=${TMPDIR:-/tmp}
  preview_parent=$(cd -P -- "$preview_parent" && pwd -P)
  preview_root=$(mktemp -d "$preview_parent/dotfiles-ranger-media.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$preview_root" "$preview_parent" dotfiles-ranger-media.' EXIT HUP INT TERM
  stub_dir="$preview_root/bin"
  minimal_dir="$preview_root/minimal-bin"
  mkdir -p -- "$stub_dir" "$minimal_dir"

  # The generated stubs intentionally expand their variables when executed.
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/bin/sh' \
    'for argument do file_path=$argument; done' \
    'case $file_path in' \
    '  *.mp4) printf "%s\n" video/mp4 ;;' \
    '  *.pdf) printf "%s\n" application/pdf ;;' \
    '  *.png) printf "%s\n" image/png ;;' \
    '  *) printf "%s\n" application/octet-stream ;;' \
    'esac' \
    >"$stub_dir/file"
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/bin/sh' \
    'output=' \
    'while [ "$#" -gt 0 ]; do' \
    '  if [ "$1" = -o ]; then shift; output=$1; break; fi' \
    '  shift' \
    'done' \
    '[ -n "$output" ] || exit 1' \
    'printf thumbnail >"$output"' \
    >"$stub_dir/ffmpegthumbnailer"
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/bin/sh' \
    'for argument do output_base=$argument; done' \
    'printf preview >"${output_base}.jpg"' \
    >"$stub_dir/pdftoppm"
  printf '%s\n' \
    '#!/bin/sh' \
    'printf "chafa preview\n"' \
    >"$stub_dir/chafa"
  for fixture in pdftotext mutool exiftool mediainfo; do
    printf '%s\n' '#!/bin/sh' 'exit 1' >"$stub_dir/$fixture"
  done
  chmod 0755 \
    "$stub_dir/file" \
    "$stub_dir/ffmpegthumbnailer" \
    "$stub_dir/pdftoppm" \
    "$stub_dir/chafa" \
    "$stub_dir/pdftotext" \
    "$stub_dir/mutool" \
    "$stub_dir/exiftool" \
    "$stub_dir/mediainfo"
  printf video >"$preview_root/movie.mp4"
  printf pdf >"$preview_root/document.pdf"
  printf image >"$preview_root/image.png"
  printf font >"$preview_root/font.otf"

  stderr=$(PATH="$stub_dir:/usr/bin:/bin" \
    home/dot_config/ranger/executable_scope.sh \
    "$preview_root/movie.mp4" 80 24 "$preview_root/video-cache.jpg" True \
    2>&1 >/dev/null)
  status=$?
  [[ $status == 6 && -z $stderr && -f $preview_root/video-cache.jpg ]] || return 1

  stderr=$(PATH="$stub_dir:/usr/bin:/bin" \
    home/dot_config/ranger/executable_scope.sh \
    "$preview_root/document.pdf" 80 24 "$preview_root/pdf-cache.jpg" True \
    2>&1 >/dev/null)
  status=$?
  [[ $status == 6 && -z $stderr && -f $preview_root/pdf-cache.jpg ]] || return 1

  for fixture in image.png movie.mp4 document.pdf; do
    output=$(PATH="$stub_dir:/usr/bin:/bin" \
      home/dot_config/ranger/executable_scope.sh \
      "$preview_root/$fixture" 80 24 "$preview_root/text-cache.jpg" False \
      2>"$preview_root/text.stderr")
    status=$?
    stderr=$(<"$preview_root/text.stderr")
    [[ $status == 4 && $output == 'chafa preview' && -z $stderr ]] || return 1
  done

  # A deliberately minimal PATH proves that every enabled media branch stays
  # quiet when its optional commands are absent.
  ln -s "$(command -v bash)" "$minimal_dir/bash"
  ln -s "$(command -v tr)" "$minimal_dir/tr"
  cp "$stub_dir/file" "$minimal_dir/file"
  for fixture in image.png movie.mp4 document.pdf font.otf; do
    for mode in False True; do
      output=$(PATH="$minimal_dir" \
        home/dot_config/ranger/executable_scope.sh \
        "$preview_root/$fixture" 80 24 "$preview_root/missing-cache.jpg" "$mode" \
        2>"$preview_root/missing.stderr")
      status=$?
      stderr=$(<"$preview_root/missing.stderr")
      [[ -z $stderr ]] || return 1
      case "$fixture:$mode" in
      image.png:True)
        [[ $status == 7 ]] || return 1
        ;;
      *)
        [[ $status == 5 && $output == *'File Type Classification'* ]] || return 1
        ;;
      esac
    done
  done
)

check_ranger_config() {
  local config=home/dot_config/ranger/rc.conf

  grep -Fxq 'set use_preview_script true' "$config"
  grep -Fxq 'set preview_script ~/.config/ranger/scope.sh' "$config"
  grep -Fxq 'set preview_images false' "$config"
  grep -Fxq 'map uT shell -w if command -v trash-restore >/dev/null 2>&1; then trash-restore; else printf '\''trash-restore is unavailable\n'\'' >&2; fi' "$config"
  if grep -Eq '^map d[tT] ' "$config"; then
    return 1
  fi
  if grep -Eq '^set preview_images_method ' "$config"; then
    return 1
  fi
}

check_ranger_config_parse() (
  set -euo pipefail

  local parse_parent
  local parse_root

  parse_parent=${TMPDIR:-/tmp}
  parse_parent=$(cd -P -- "$parse_parent" && pwd -P)
  parse_root=$(mktemp -d "$parse_parent/dotfiles-ranger-parse.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$parse_root" "$parse_parent" dotfiles-ranger-parse.' EXIT HUP INT TERM
  mkdir -p -- "$parse_root/cache" "$parse_root/data" "$parse_root/root"

  python3 - \
    "$(command -v ranger)" \
    "$repo_root/home/dot_config/ranger" \
    "$parse_root" <<'PY'
import os
import pty
import select
import signal
import sys
import time

ranger, config, root = sys.argv[1:]
argv = [
    ranger,
    f"--confdir={config}",
    f"--cachedir={root}/cache",
    f"--datadir={root}/data",
    "--cmd=quit!",
    f"{root}/root",
]
environment = os.environ.copy()
environment.update({"HOME": f"{root}/home", "TERM": "xterm-256color"})

pid, fd = pty.fork()
if pid == 0:
    os.execve(ranger, argv, environment)

output = bytearray()
deadline = time.monotonic() + 10
status = None
try:
    while time.monotonic() < deadline:
        ready, _, _ = select.select([fd], [], [], 0.1)
        if ready:
            try:
                output.extend(os.read(fd, 65536))
            except OSError:
                pass
        waited, child_status = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            status = child_status
            break
    if status is None:
        os.killpg(pid, signal.SIGTERM)
        time.sleep(0.2)
        try:
            os.killpg(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        _, status = os.waitpid(pid, 0)
finally:
    os.close(fd)

if not os.WIFEXITED(status) or os.WEXITSTATUS(status) != 0:
    raise SystemExit("ranger did not exit cleanly after loading rc.conf")
decoded = output.decode("utf-8", errors="replace")
for marker in ("Error in line", "Unknown command", "Traceback"):
    if marker in decoded:
        raise SystemExit(f"ranger reported a configuration error: {marker}")
PY
)

check_chezmoi_profile() (
  set -euo pipefail

  local linux_x11=$1
  local chezmoi_executable
  local integration_parent
  local integration_root
  local destination
  local backup_parent
  local bootstrap_log
  local config_snapshot
  local profile_flag
  local profile_data
  local managed_output
  local dry_run_output
  local target
  local -a cm
  local -a core_targets
  local -a x11_targets

  chezmoi_executable=$(command -v chezmoi)
  [[ $chezmoi_executable == /* ]]

  integration_parent=${TMPDIR:-/tmp}
  integration_parent=$(cd -P -- "$integration_parent" && pwd -P)
  integration_root=$(mktemp -d "$integration_parent/dotfiles-check.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$integration_root" "$integration_parent" dotfiles-check.' EXIT HUP INT TERM

  destination="$integration_root/destination"
  backup_parent="$integration_root/backups"
  bootstrap_log="$integration_root/bootstrap.log"
  mkdir -p -- "$destination" "$backup_parent"

  if [[ $linux_x11 == true ]]; then
    profile_flag=--linux-x11
    profile_data=true
  else
    profile_flag=--no-linux-x11
    profile_data=false
  fi

  if ! "$repo_root/scripts/bootstrap" \
    --apply \
    --non-interactive \
    "$profile_flag" \
    --destination "$destination" \
    --backup-parent "$backup_parent" \
    --chezmoi "$chezmoi_executable" \
    >"$bootstrap_log" 2>&1; then
    printf 'chezmoi bootstrap integration failed:\n' >&2
    command cat "$bootstrap_log" >&2
    return 1
  fi

  # Bootstrap must not regenerate and truncate valid local chezmoi settings
  # after the first initialization.
  printf '\n[diff]\npager = "cat"\n' >>"$destination/.config/chezmoi/chezmoi.toml"
  config_snapshot="$integration_root/chezmoi.toml.before-preview"
  cp "$destination/.config/chezmoi/chezmoi.toml" "$config_snapshot"
  if ! "$repo_root/scripts/bootstrap" \
    --non-interactive \
    "$profile_flag" \
    --destination "$destination" \
    --backup-parent "$backup_parent" \
    --chezmoi "$chezmoi_executable" \
    >"$bootstrap_log" 2>&1; then
    printf 'same-source chezmoi preview failed:\n' >&2
    command cat "$bootstrap_log" >&2
    return 1
  fi
  cmp "$config_snapshot" "$destination/.config/chezmoi/chezmoi.toml"

  if [[ $linux_x11 == true ]]; then
    # On Linux, non-interactive daily use without a profile flag must respect
    # the persisted true value instead of silently overriding it to false.
    if ! "$repo_root/scripts/bootstrap" \
      --non-interactive \
      --destination "$destination" \
      --backup-parent "$backup_parent" \
      --chezmoi "$chezmoi_executable" \
      >"$bootstrap_log" 2>&1; then
      printf 'persisted Linux X11 profile preview failed:\n' >&2
      command cat "$bootstrap_log" >&2
      return 1
    fi
    cmp "$config_snapshot" "$destination/.config/chezmoi/chezmoi.toml"
    managed_output=$(
      "$chezmoi_executable" \
        --source "$repo_root" \
        --destination "$destination" \
        --config "$destination/.config/chezmoi/chezmoi.toml" \
        --config-format toml \
        --cache "$destination/.cache/chezmoi" \
        --persistent-state "$destination/.local/state/chezmoi/chezmoistate.boltdb" \
        managed --format= --include=files --path-style=relative
    )
    grep -Fxq '.config/i3/config' <<<"$managed_output"
    grep -Fxq '.config/picom/picom.conf' <<<"$managed_output"
  fi

  grep -Fxq "linuxX11 = $profile_data" \
    "$destination/.config/chezmoi/chezmoi.toml"

  cm=(
    "$chezmoi_executable"
    --source "$repo_root"
    --destination "$destination"
    --config "$destination/.config/chezmoi/chezmoi.toml"
    --config-format toml
    --cache "$destination/.cache/chezmoi"
    --persistent-state "$destination/.local/state/chezmoi/chezmoistate.boltdb"
    --override-data "{\"profiles\":{\"linuxX11\":$profile_data}}"
    --no-tty
  )

  "${cm[@]}" verify

  core_targets=(
    .config/alacritty/alacritty.toml
    .config/fish/config.fish
    .config/nvim/init.lua
    .config/ranger/rc.conf
    .config/ranger/scope.sh
    .config/tmux/tmux.conf
  )
  for target in "${core_targets[@]}"; do
    [[ -f $destination/$target ]]
  done
  [[ -x $destination/.config/ranger/scope.sh ]]
  [[ ! -e $destination/.config/fish/fish_variables ]]

  x11_targets=(
    .Xmodmap
    .Xresources
    .xinitrc
    .xprofile
    .config/i3/config
    .config/picom/picom.conf
  )
  if [[ $linux_x11 == true ]]; then
    for target in "${x11_targets[@]}"; do
      [[ -f $destination/$target ]]
    done
    [[ -x $destination/.xinitrc ]]
  else
    for target in "${x11_targets[@]}"; do
      [[ ! -e $destination/$target && ! -L $destination/$target ]]
    done
  fi

  dry_run_output=$("${cm[@]}" --no-pager --dry-run apply 2>&1)
  if [[ -n $dry_run_output ]]; then
    printf 'second chezmoi apply --dry-run was not empty:\n%s\n' "$dry_run_output" >&2
    return 1
  fi
)

check_chezmoi_migration_restore() (
  set -euo pipefail

  local chezmoi_executable
  local migration_parent
  local migration_root
  local destination
  local backup_parent
  local bootstrap_log
  local backup_dir=
  local backup_count=0
  local candidate
  local original_fish
  local original_link='../../original-tmux.conf'

  chezmoi_executable=$(command -v chezmoi)
  [[ $chezmoi_executable == /* ]]

  migration_parent=${TMPDIR:-/tmp}
  migration_parent=$(cd -P -- "$migration_parent" && pwd -P)
  migration_root=$(mktemp -d "$migration_parent/dotfiles-migration.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$migration_root" "$migration_parent" dotfiles-migration.' EXIT HUP INT TERM

  destination="$migration_root/destination"
  backup_parent="$migration_root/backups"
  bootstrap_log="$migration_root/bootstrap.log"
  original_fish="$migration_root/original-fish-config"
  mkdir -p -- "$destination/.config/fish/conf.d" "$destination/.config/tmux" "$backup_parent"
  chmod 0700 "$destination/.config" "$destination/.config/fish"
  printf 'pre-existing fish config\n' >"$original_fish"
  cp "$original_fish" "$destination/.config/fish/config.fish"
  printf 'symlink payload\n' >"$destination/original-tmux.conf"
  ln -s "$original_link" "$destination/.config/tmux/tmux.conf"
  printf 'legacy z plugin\n' >"$destination/.config/fish/conf.d/z.fish"
  printf 'legacy Fisher manifest\n' >"$destination/.config/fish/fish_plugins"

  # Without a TTY or explicit force, pre-existing targets must remain intact.
  if "$repo_root/scripts/bootstrap" \
    --apply \
    --non-interactive \
    --no-linux-x11 \
    --destination "$destination" \
    --backup-parent "$backup_parent" \
    --chezmoi "$chezmoi_executable" \
    >"$bootstrap_log" 2>&1; then
    printf 'non-interactive migration unexpectedly overwrote without --force\n' >&2
    return 1
  fi
  cmp "$original_fish" "$destination/.config/fish/config.fish"
  [[ -L $destination/.config/tmux/tmux.conf ]]
  [[ $(readlink "$destination/.config/tmux/tmux.conf") == "$original_link" ]]
  [[ -f $destination/.config/fish/conf.d/z.fish ]]
  [[ -f $destination/.config/fish/fish_plugins ]]

  if ! "$repo_root/scripts/bootstrap" \
    --apply \
    --force \
    --clean-legacy \
    --non-interactive \
    --no-linux-x11 \
    --destination "$destination" \
    --backup-parent "$backup_parent" \
    --chezmoi "$chezmoi_executable" \
    >"$bootstrap_log" 2>&1; then
    printf 'forced migration bootstrap failed:\n' >&2
    command cat "$bootstrap_log" >&2
    return 1
  fi

  for candidate in "$backup_parent"/backup-*; do
    [[ -d $candidate ]] || continue
    backup_count=$((backup_count + 1))
    if grep -Fqx $'present\t.config/fish/conf.d/z.fish' "$candidate/manifest.tsv"; then
      backup_dir=$candidate
    fi
  done
  # The safe failed attempt and the forced attempt both retain a recoverable
  # pre-apply backup.
  [[ $backup_count == 2 && -n $backup_dir ]]
  grep -Fqx $'present\t.config/fish/config.fish' "$backup_dir/manifest.tsv"
  grep -Fqx $'present\t.config/tmux/tmux.conf' "$backup_dir/manifest.tsv"
  grep -Fqx $'present\t.config/fish/conf.d/z.fish' "$backup_dir/manifest.tsv"
  grep -Fqx $'present\t.config/fish/fish_plugins' "$backup_dir/manifest.tsv"
  grep -Fqx $'directory\t.config\t700' "$backup_dir/manifest.tsv"
  grep -Fqx $'directory\t.config/fish\t700' "$backup_dir/manifest.tsv"
  cmp "$repo_root/home/dot_config/fish/config.fish" "$destination/.config/fish/config.fish"
  [[ ! -L $destination/.config/tmux/tmux.conf ]]
  [[ ! -e $destination/.config/fish/conf.d/z.fish ]]
  [[ ! -e $destination/.config/fish/fish_plugins ]]

  # Preview is read-only and the first apply restore keeps newly-created files.
  "$repo_root/scripts/restore" "$backup_dir" >"$migration_root/restore-preview.log" 2>&1
  cmp "$repo_root/home/dot_config/fish/config.fish" "$destination/.config/fish/config.fish"
  "$repo_root/scripts/restore" --apply "$backup_dir" >"$migration_root/restore-apply.log" 2>&1
  cmp "$original_fish" "$destination/.config/fish/config.fish"
  [[ -L $destination/.config/tmux/tmux.conf ]]
  [[ $(readlink "$destination/.config/tmux/tmux.conf") == "$original_link" ]]
  [[ -f $destination/.config/nvim/init.lua ]]
  grep -Fqx 'legacy z plugin' "$destination/.config/fish/conf.d/z.fish"
  grep -Fqx 'legacy Fisher manifest' "$destination/.config/fish/fish_plugins"
  [[ $(python3 -c 'import os, stat, sys; print(format(stat.S_IMODE(os.stat(sys.argv[1]).st_mode), "o"))' "$destination/.config") == 700 ]]
  [[ $(python3 -c 'import os, stat, sys; print(format(stat.S_IMODE(os.stat(sys.argv[1]).st_mode), "o"))' "$destination/.config/fish") == 700 ]]

  # Removing first-created targets is a separate, explicit restore operation.
  "$repo_root/scripts/restore" --apply --remove-created "$backup_dir" \
    >"$migration_root/restore-remove-created.log" 2>&1
  cmp "$original_fish" "$destination/.config/fish/config.fish"
  [[ -L $destination/.config/tmux/tmux.conf ]]
  [[ $(readlink "$destination/.config/tmux/tmux.conf") == "$original_link" ]]
  [[ ! -e $destination/.config/nvim/init.lua ]]
  grep -Fqx 'legacy z plugin' "$destination/.config/fish/conf.d/z.fish"
  grep -Fqx 'legacy Fisher manifest' "$destination/.config/fish/fish_plugins"
  [[ $(python3 -c 'import os, stat, sys; print(format(stat.S_IMODE(os.stat(sys.argv[1]).st_mode), "o"))' "$destination/.config") == 700 ]]
  [[ $(python3 -c 'import os, stat, sys; print(format(stat.S_IMODE(os.stat(sys.argv[1]).st_mode), "o"))' "$destination/.config/fish") == 700 ]]
)

check_chezmoi_interactive_cancel() (
  set -euo pipefail

  local chezmoi_executable
  local cancel_parent
  local cancel_root
  local destination
  local backup_parent
  local cancel_log
  local original_fish

  chezmoi_executable=$(command -v chezmoi)
  [[ $chezmoi_executable == /* ]]
  cancel_parent=${TMPDIR:-/tmp}
  cancel_parent=$(cd -P -- "$cancel_parent" && pwd -P)
  cancel_root=$(mktemp -d "$cancel_parent/dotfiles-cancel.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$cancel_root" "$cancel_parent" dotfiles-cancel.' EXIT HUP INT TERM

  destination="$cancel_root/destination"
  backup_parent="$cancel_root/backups"
  cancel_log="$cancel_root/bootstrap.log"
  original_fish="$cancel_root/original-fish-config"
  mkdir -p -- "$destination/.config/fish" "$backup_parent"
  chmod 0700 "$destination/.config" "$destination/.config/fish"
  printf 'pre-existing fish config\n' >"$original_fish"
  cp "$original_fish" "$destination/.config/fish/config.fish"

  # chezmoi returns success when an interactive user chooses quit. Drive a real
  # pseudo-terminal and prove the subsequent verify failure is transactional.
  if ! python3 - \
    "$repo_root/scripts/bootstrap" \
    --apply \
    --no-linux-x11 \
    --destination "$destination" \
    --backup-parent "$backup_parent" \
    --chezmoi "$chezmoi_executable" \
    >"$cancel_log" 2>&1 <<'PY'
import os
import pty
import select
import signal
import sys
import time

argv = sys.argv[1:]


def terminate_process_group(pid, term_grace):
    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass

    deadline = time.monotonic() + term_grace
    status = None
    while time.monotonic() < deadline:
        if status is None:
            waited, child_status = os.waitpid(pid, os.WNOHANG)
            if waited == pid:
                status = child_status
        if status is not None:
            try:
                os.killpg(pid, 0)
            except ProcessLookupError:
                return status
        time.sleep(0.05)

    try:
        os.killpg(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    if status is None:
        _, status = os.waitpid(pid, 0)
    return status


def drive_pty(argv, expected, response, timeout, term_grace, stream_output):
    pid, fd = pty.fork()
    if pid == 0:
        os.execv(argv[0], argv)

    deadline = time.monotonic() + timeout
    output = bytearray()
    sent_response = False
    status = None
    timed_out = False

    try:
        while status is None:
            if time.monotonic() >= deadline:
                timed_out = True
                status = terminate_process_group(pid, term_grace)
                break

            ready, _, _ = select.select([fd], [], [], 0.1)
            if ready:
                try:
                    data = os.read(fd, 4096)
                except OSError:
                    data = b""
                if data:
                    if stream_output:
                        sys.stdout.buffer.write(data)
                        sys.stdout.buffer.flush()
                    output.extend(data)
                    if not sent_response and expected in output:
                        os.write(fd, response)
                        sent_response = True

            waited, child_status = os.waitpid(pid, os.WNOHANG)
            if waited == pid:
                status = child_status
    finally:
        os.close(fd)

    return status, sent_response, timed_out, bytes(output)


status, sent_quit, timed_out, _ = drive_pty(
    argv,
    b"already exists?",
    b"q\n",
    timeout=60,
    term_grace=5,
    stream_output=True,
)
if timed_out:
    raise SystemExit("timed out waiting for the chezmoi conflict prompt")
if not sent_quit:
    raise SystemExit("chezmoi conflict prompt was not observed")
if os.waitstatus_to_exitcode(status) == 0:
    raise SystemExit("bootstrap unexpectedly succeeded after interactive quit")

# Exercise the timeout's bounded SIGKILL fallback with a stubborn process
# group, without making the normal regression path wait for the long deadline.
probe = (
    "import os, signal, time; "
    "signal.signal(signal.SIGTERM, signal.SIG_IGN); "
    "child = os.fork(); "
    "child == 0 and signal.signal(signal.SIGTERM, signal.SIG_IGN); "
    "print('probe-ready', flush=True); "
    "time.sleep(60)"
)
_, _, probe_timed_out, probe_output = drive_pty(
    [sys.executable, "-c", probe],
    b"never-send-a-response",
    b"",
    timeout=0.2,
    term_grace=0.2,
    stream_output=False,
)
if not probe_timed_out or b"probe-ready" not in probe_output:
    raise SystemExit("PTY process-group timeout regression failed")
PY
  then
    printf 'interactive cancel regression failed:\n' >&2
    command cat "$cancel_log" >&2
    return 1
  fi

  cmp "$original_fish" "$destination/.config/fish/config.fish"
  [[ $(python3 -c 'import os, stat, sys; print(format(stat.S_IMODE(os.stat(sys.argv[1]).st_mode), "o"))' "$destination/.config") == 700 ]]
  [[ $(python3 -c 'import os, stat, sys; print(format(stat.S_IMODE(os.stat(sys.argv[1]).st_mode), "o"))' "$destination/.config/fish") == 700 ]]
  [[ ! -e $destination/.config/alacritty/alacritty.toml ]]
  [[ ! -e $destination/.config/nvim/init.lua ]]
  [[ $(find "$backup_parent" -mindepth 1 -maxdepth 1 -type d -name 'backup-*' | wc -l | tr -d ' ') == 1 ]]
  grep -Fq 'Post-apply verification failed or the interactive migration was cancelled' "$cancel_log"
  grep -Fq 'Automatic rollback completed' "$cancel_log"
)

check_signal_exit_contracts() (
  set -euo pipefail

  local chezmoi_executable
  local signal_parent
  local signal_root
  local active_pid=
  local active_release=
  local bootstrap_destination
  local bootstrap_backup_parent
  local bootstrap_marker
  local bootstrap_release
  local bootstrap_log
  local bootstrap_pid
  local bootstrap_status
  local original_fish
  local backup_destination
  local backup_parent
  local backup_paths
  local backup_marker
  local backup_release
  local backup_log
  local backup_output
  local backup_pid
  local backup_status
  local restore_backup
  local restore_marker
  local restore_release
  local restore_log
  local restore_pid
  local restore_status
  local installer_bin
  local installer_marker
  local installer_release
  local installer_log
  local installer_pid
  local installer_status
  local real_cp

  wait_for_marker() {
    local marker=$1
    local pid=$2
    local count

    for ((count = 0; count < 300; count++)); do
      [[ -e $marker ]] && return 0
      kill -0 "$pid" 2>/dev/null || return 1
      sleep 0.1
    done
    return 1
  }

  # shellcheck disable=SC2317,SC2329
  cleanup_signal_contracts() {
    if [[ -n $active_pid ]] && kill -0 "$active_pid" 2>/dev/null; then
      [[ -z $active_release ]] || : >"$active_release"
      kill -TERM "$active_pid" 2>/dev/null || true
      wait "$active_pid" 2>/dev/null || true
    fi
    dotfiles_safe_cleanup_tree "$signal_root" "$signal_parent" dotfiles-signals.
  }

  chezmoi_executable=$(command -v chezmoi)
  real_cp=$(command -v cp)
  [[ $chezmoi_executable == /* && $real_cp == /* ]]
  signal_parent=${TMPDIR:-/tmp}
  signal_parent=$(cd -P -- "$signal_parent" && pwd -P)
  signal_root=$(mktemp -d "$signal_parent/dotfiles-signals.XXXXXXXX")
  trap cleanup_signal_contracts EXIT HUP INT TERM

  mkdir -p -- "$signal_root/mock-chezmoi" "$signal_root/mock-cp"
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'is_apply=0' \
    'for argument in "$@"; do' \
    '  [[ $argument != apply ]] || is_apply=1' \
    'done' \
    '"$DOTFILES_TEST_REAL_CHEZMOI" "$@"' \
    'status=$?' \
    'if ((is_apply == 1 && status == 0)); then' \
    '  : >"$DOTFILES_TEST_MARKER"' \
    '  for ((index = 0; index < 300; index++)); do' \
    '    [[ ! -e $DOTFILES_TEST_RELEASE ]] || exit "$status"' \
    '    sleep 0.1' \
    '  done' \
    '  exit 124' \
    'fi' \
    'exit "$status"' \
    >"$signal_root/mock-chezmoi/chezmoi"
  chmod 0755 "$signal_root/mock-chezmoi/chezmoi"

  # Signal the bootstrap main PID only after the child chezmoi apply has
  # written managed targets. Bash delivers the pending trap when the child
  # returns; the handler must rollback and exit 143 instead of verifying and
  # printing success.
  bootstrap_destination="$signal_root/bootstrap-destination"
  bootstrap_backup_parent="$signal_root/bootstrap-backups"
  bootstrap_marker="$signal_root/bootstrap-applied"
  bootstrap_release="$signal_root/bootstrap-release"
  bootstrap_log="$signal_root/bootstrap.log"
  original_fish="$signal_root/original-fish"
  mkdir -p -- "$bootstrap_destination/.config/fish" "$bootstrap_backup_parent"
  printf 'pre-signal fish config\n' >"$original_fish"
  cp "$original_fish" "$bootstrap_destination/.config/fish/config.fish"

  DOTFILES_TEST_REAL_CHEZMOI="$chezmoi_executable" \
    DOTFILES_TEST_MARKER="$bootstrap_marker" \
    DOTFILES_TEST_RELEASE="$bootstrap_release" \
    "$repo_root/scripts/bootstrap" \
      --apply \
      --force \
      --non-interactive \
      --no-linux-x11 \
      --destination "$bootstrap_destination" \
      --backup-parent "$bootstrap_backup_parent" \
      --chezmoi "$signal_root/mock-chezmoi/chezmoi" \
      >"$bootstrap_log" 2>&1 &
  bootstrap_pid=$!
  active_pid=$bootstrap_pid
  active_release=$bootstrap_release
  wait_for_marker "$bootstrap_marker" "$bootstrap_pid"
  cmp "$repo_root/home/dot_config/fish/config.fish" \
    "$bootstrap_destination/.config/fish/config.fish"
  kill -TERM "$bootstrap_pid"
  : >"$bootstrap_release"
  if wait "$bootstrap_pid"; then
    bootstrap_status=0
  else
    bootstrap_status=$?
  fi
  active_pid=
  active_release=

  [[ $bootstrap_status == 143 ]]
  cmp "$original_fish" "$bootstrap_destination/.config/fish/config.fish"
  [[ ! -e $bootstrap_destination/.config/nvim/init.lua ]]
  grep -Fq 'Apply interrupted by a signal' "$bootstrap_log"
  grep -Fq 'Automatic rollback completed' "$bootstrap_log"
  if grep -Fq 'Apply and verification completed successfully.' "$bootstrap_log"; then
    return 1
  fi

  # Block cp after it has copied a payload but before the parent shell resumes.
  # This gives backup and restore a deterministic child phase for TERM tests.
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    '"$DOTFILES_TEST_REAL_CP" "$@"' \
    'status=$?' \
    ': >"$DOTFILES_TEST_MARKER"' \
    'for ((index = 0; index < 300; index++)); do' \
    '  [[ ! -e $DOTFILES_TEST_RELEASE ]] || exit "$status"' \
    '  sleep 0.1' \
    'done' \
    'exit 124' \
    >"$signal_root/mock-cp/cp"
  chmod 0755 "$signal_root/mock-cp/cp"

  backup_destination="$signal_root/backup-destination"
  backup_parent="$signal_root/backup-parent"
  backup_paths="$signal_root/backup-paths"
  backup_marker="$signal_root/backup-copied"
  backup_release="$signal_root/backup-release"
  backup_log="$signal_root/backup.log"
  backup_output="$signal_root/backup.out"
  mkdir -p -- "$backup_destination" "$backup_parent"
  printf 'backup payload\n' >"$backup_destination/managed"
  printf 'managed\n' >"$backup_paths"

  PATH="$signal_root/mock-cp:$PATH" \
    DOTFILES_TEST_REAL_CP="$real_cp" \
    DOTFILES_TEST_MARKER="$backup_marker" \
    DOTFILES_TEST_RELEASE="$backup_release" \
    "$repo_root/scripts/backup" \
      --destination "$backup_destination" \
      --output-parent "$backup_parent" \
      --paths-file "$backup_paths" \
      >"$backup_output" 2>"$backup_log" &
  backup_pid=$!
  active_pid=$backup_pid
  active_release=$backup_release
  wait_for_marker "$backup_marker" "$backup_pid"
  kill -TERM "$backup_pid"
  : >"$backup_release"
  if wait "$backup_pid"; then
    backup_status=0
  else
    backup_status=$?
  fi
  active_pid=
  active_release=

  [[ $backup_status == 143 ]]
  [[ -z $(find "$backup_parent" -mindepth 1 -maxdepth 1 -name 'backup-*' -print -quit) ]]
  if grep -Fq 'Backed up ' "$backup_log"; then
    return 1
  fi

  restore_backup=$(
    "$repo_root/scripts/backup" \
      --destination "$backup_destination" \
      --output-parent "$backup_parent" \
      --paths-file "$backup_paths" \
      2>"$signal_root/restore-backup.log"
  )
  printf 'changed before interrupted restore\n' >"$backup_destination/managed"
  restore_marker="$signal_root/restore-copied"
  restore_release="$signal_root/restore-release"
  restore_log="$signal_root/restore.log"

  PATH="$signal_root/mock-cp:$PATH" \
    DOTFILES_TEST_REAL_CP="$real_cp" \
    DOTFILES_TEST_MARKER="$restore_marker" \
    DOTFILES_TEST_RELEASE="$restore_release" \
    "$repo_root/scripts/restore" --apply "$restore_backup" \
      >"$restore_log" 2>&1 &
  restore_pid=$!
  active_pid=$restore_pid
  active_release=$restore_release
  wait_for_marker "$restore_marker" "$restore_pid"
  kill -TERM "$restore_pid"
  : >"$restore_release"
  if wait "$restore_pid"; then
    restore_status=0
  else
    restore_status=$?
  fi
  active_pid=
  active_release=

  [[ $restore_status == 143 ]]
  grep -Fqx 'changed before interrupted restore' "$backup_destination/managed"
  [[ -z $(find "$backup_destination" -name '.dotfiles-restore.*' -print -quit) ]]
  if grep -Fq 'Restored ' "$restore_log"; then
    return 1
  fi

  # The installer checks an existing executable in a child command. TERM of
  # the installer main PID must prevent the subsequent already-installed
  # success path even when that child later reports the pinned version.
  installer_bin="$signal_root/installer-bin"
  installer_marker="$signal_root/installer-version-checked"
  installer_release="$signal_root/installer-release"
  installer_log="$signal_root/installer.log"
  mkdir -p -- "$installer_bin"
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    '[[ ${1:-} == --version ]] || exit 64' \
    ': >"$DOTFILES_TEST_MARKER"' \
    'for ((index = 0; index < 300; index++)); do' \
    '  if [[ -e $DOTFILES_TEST_RELEASE ]]; then' \
    '    printf "%s\\n" "chezmoi version v2.72.0"' \
    '    exit 0' \
    '  fi' \
    '  sleep 0.1' \
    'done' \
    'exit 124' \
    >"$installer_bin/chezmoi"
  chmod 0755 "$installer_bin/chezmoi"

  DOTFILES_TEST_MARKER="$installer_marker" \
    DOTFILES_TEST_RELEASE="$installer_release" \
    "$repo_root/scripts/install-chezmoi" --bin-dir "$installer_bin" \
      >"$installer_log" 2>&1 &
  installer_pid=$!
  active_pid=$installer_pid
  active_release=$installer_release
  wait_for_marker "$installer_marker" "$installer_pid"
  kill -TERM "$installer_pid"
  : >"$installer_release"
  if wait "$installer_pid"; then
    installer_status=0
  else
    installer_status=$?
  fi
  active_pid=
  active_release=

  [[ $installer_status == 143 ]]
  if grep -Fq 'already installed' "$installer_log" ||
    grep -Fq 'Installed chezmoi' "$installer_log"; then
    return 1
  fi
)

check_chezmoi_clean_legacy_rollback() (
  set -euo pipefail

  local chezmoi_executable
  local cleanup_parent
  local cleanup_root
  local destination
  local backup_parent
  local mock_bin
  local cleanup_log
  local original_fisher
  local original_z
  local real_rm

  chezmoi_executable=$(command -v chezmoi)
  real_rm=$(command -v rm)
  [[ $chezmoi_executable == /* && $real_rm == /* ]]
  cleanup_parent=${TMPDIR:-/tmp}
  cleanup_parent=$(cd -P -- "$cleanup_parent" && pwd -P)
  cleanup_root=$(mktemp -d "$cleanup_parent/dotfiles-clean-rollback.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$cleanup_root" "$cleanup_parent" dotfiles-clean-rollback.' EXIT HUP INT TERM

  destination="$cleanup_root/destination"
  backup_parent="$cleanup_root/backups"
  mock_bin="$cleanup_root/mock-bin"
  cleanup_log="$cleanup_root/bootstrap.log"
  original_fisher="$cleanup_root/original-fisher"
  original_z="$cleanup_root/original-z"
  mkdir -p -- \
    "$destination/.config/fish/completions" \
    "$destination/.config/fish/conf.d" \
    "$backup_parent" \
    "$mock_bin"
  printf 'legacy fisher completion\n' >"$original_fisher"
  printf 'legacy z plugin\n' >"$original_z"
  cp "$original_fisher" "$destination/.config/fish/completions/fisher.fish"
  cp "$original_z" "$destination/.config/fish/conf.d/z.fish"

  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'for argument in "$@"; do' \
    '  case $argument in' \
    '    */.config/fish/conf.d/z.fish) exit 73 ;;' \
    '  esac' \
    'done' \
    'exec "$DOTFILES_TEST_REAL_RM" "$@"' \
    >"$mock_bin/rm"
  chmod 0755 "$mock_bin/rm"

  if PATH="$mock_bin:$PATH" DOTFILES_TEST_REAL_RM="$real_rm" \
    "$repo_root/scripts/bootstrap" \
      --apply \
      --force \
      --clean-legacy \
      --non-interactive \
      --no-linux-x11 \
      --destination "$destination" \
      --backup-parent "$backup_parent" \
      --chezmoi "$chezmoi_executable" \
      >"$cleanup_log" 2>&1; then
    printf 'bootstrap unexpectedly succeeded after a mid-cleanup deletion failure\n' >&2
    return 1
  fi

  cmp "$original_fisher" "$destination/.config/fish/completions/fisher.fish"
  cmp "$original_z" "$destination/.config/fish/conf.d/z.fish"
  [[ ! -e $destination/.config/nvim/init.lua ]]
  grep -Fq 'Retired Fish cleanup failed' "$cleanup_log"
  grep -Fq 'Automatic rollback completed' "$cleanup_log"
  if grep -Fq 'Apply and verification completed successfully.' "$cleanup_log"; then
    return 1
  fi
)

check_chezmoi_destination_symlink_safety() (
  set -euo pipefail

  local chezmoi_executable
  local safety_parent
  local safety_root
  local destination
  local outside
  local backup_destination
  local backup_outside
  local bootstrap_log
  local backup_log

  chezmoi_executable=$(command -v chezmoi)
  [[ $chezmoi_executable == /* ]]
  safety_parent=${TMPDIR:-/tmp}
  safety_parent=$(cd -P -- "$safety_parent" && pwd -P)
  safety_root=$(mktemp -d "$safety_parent/dotfiles-bootstrap-safety.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$safety_root" "$safety_parent" dotfiles-bootstrap-safety.' EXIT HUP INT TERM

  destination="$safety_root/destination"
  outside="$safety_root/outside"
  bootstrap_log="$safety_root/bootstrap.log"
  mkdir -p -- "$destination" "$outside"
  ln -s "$outside" "$destination/.config"

  if "$repo_root/scripts/bootstrap" \
    --non-interactive \
    --no-linux-x11 \
    --destination "$destination" \
    --chezmoi "$chezmoi_executable" \
    >"$bootstrap_log" 2>&1; then
    printf 'bootstrap preview unexpectedly followed a destination parent symlink\n' >&2
    return 1
  fi

  [[ -L $destination/.config ]]
  [[ $(readlink "$destination/.config") == "$outside" ]]
  [[ -z $(find "$outside" -mindepth 1 -maxdepth 1 -print -quit) ]]
  [[ ! -e $destination/.cache && ! -L $destination/.cache ]]
  [[ ! -e $destination/.local && ! -L $destination/.local ]]
  grep -Fq "refusing symlinked parent: $destination/.config" "$bootstrap_log"

  # With an explicit destination, the implicit backup parent is
  # destination-local. Its complete parent chain must be validated before
  # bootstrap creates config/cache/state paths or initializes chezmoi.
  backup_destination="$safety_root/backup-destination"
  backup_outside="$safety_root/backup-outside"
  backup_log="$safety_root/backup-boundary.log"
  mkdir -p -- "$backup_destination/.local/state" "$backup_outside"
  ln -s "$backup_outside" "$backup_destination/.local/state/dotfiles"

  if "$repo_root/scripts/bootstrap" \
    --non-interactive \
    --no-linux-x11 \
    --destination "$backup_destination" \
    --chezmoi "$chezmoi_executable" \
    >"$backup_log" 2>&1; then
    printf 'bootstrap preview unexpectedly followed the default backup parent symlink\n' >&2
    return 1
  fi

  [[ -L $backup_destination/.local/state/dotfiles ]]
  [[ $(readlink "$backup_destination/.local/state/dotfiles") == "$backup_outside" ]]
  [[ -z $(find "$backup_outside" -mindepth 1 -maxdepth 1 -print -quit) ]]
  [[ ! -e $backup_destination/.config && ! -L $backup_destination/.config ]]
  [[ ! -e $backup_destination/.cache && ! -L $backup_destination/.cache ]]
  [[ ! -e $backup_destination/.local/state/chezmoi && ! -L $backup_destination/.local/state/chezmoi ]]
  grep -Fq "refusing symlinked parent: $backup_destination/.local/state/dotfiles" "$backup_log"
)

check_restore_symlink_directory_safety() (
  set -euo pipefail

  local restore_parent
  local restore_root
  local destination
  local paths_file
  local backup_dir
  local outside

  restore_parent=${TMPDIR:-/tmp}
  restore_parent=$(cd -P -- "$restore_parent" && pwd -P)
  restore_root=$(mktemp -d "$restore_parent/dotfiles-restore-safety.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$restore_root" "$restore_parent" dotfiles-restore-safety.' EXIT HUP INT TERM
  destination="$restore_root/destination"
  outside="$restore_root/outside"
  paths_file="$restore_root/paths"
  mkdir -p -- "$destination" "$restore_root/backups" "$outside"
  printf 'original\n' >"$destination/managed-file"
  ln -s "$outside" "$destination/managed-link"
  printf 'managed-file\nmanaged-link\n' >"$paths_file"

  backup_dir=$("$repo_root/scripts/backup" \
    --paths-file "$paths_file" \
    --destination "$destination" \
    --output-parent "$restore_root/backups" \
    2>"$restore_root/backup.log")

  rm -f -- "$destination/managed-file" "$destination/managed-link"
  ln -s "$outside" "$destination/managed-file"
  printf 'changed\n' >"$destination/managed-link"

  "$repo_root/scripts/restore" --apply "$backup_dir" >"$restore_root/restore.log" 2>&1
  [[ -f $destination/managed-file && ! -L $destination/managed-file ]]
  [[ $(cat "$destination/managed-file") == original ]]
  [[ -L $destination/managed-link ]]
  [[ $(readlink "$destination/managed-link") == "$outside" ]]
  [[ -z $(find "$outside" -mindepth 1 -maxdepth 1 -print -quit) ]]
)

check_installer_path_shadow() (
  set -euo pipefail

  local chezmoi_executable
  local installer_parent
  local installer_root
  local target_dir
  local shadow_dir
  local installer_log

  chezmoi_executable=$(command -v chezmoi)
  [[ $chezmoi_executable == /* ]]

  installer_parent=${TMPDIR:-/tmp}
  installer_parent=$(cd -P -- "$installer_parent" && pwd -P)
  installer_root=$(mktemp -d "$installer_parent/dotfiles-installer.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$installer_root" "$installer_parent" dotfiles-installer.' EXIT HUP INT TERM
  target_dir="$installer_root/target with space"
  shadow_dir="$installer_root/shadow"
  installer_log="$installer_root/install.log"
  mkdir -p -- "$target_dir" "$shadow_dir"

  cp "$chezmoi_executable" "$target_dir/chezmoi"
  printf '%s\n' \
    '#!/bin/sh' \
    'printf "%s\\n" "chezmoi version v2.70.0"' \
    >"$shadow_dir/chezmoi"
  chmod 0755 "$shadow_dir/chezmoi"

  PATH="$shadow_dir:$PATH" \
    "$repo_root/scripts/install-chezmoi" --bin-dir "$target_dir" \
    >"$installer_log" 2>&1

  grep -Fq "PATH currently resolves chezmoi to $shadow_dir/chezmoi" "$installer_log"
  grep -Fq -- '--chezmoi' "$installer_log"

  mkdir -p -- "$installer_root/symlink-bin" "$installer_root/outside"
  ln -s "$installer_root/outside" "$installer_root/symlink-bin/chezmoi"
  if "$repo_root/scripts/install-chezmoi" \
    --force \
    --bin-dir "$installer_root/symlink-bin" \
    >"$installer_log" 2>&1; then
    printf 'installer unexpectedly followed a target symlink to a directory\n' >&2
    return 1
  fi
  [[ -L $installer_root/symlink-bin/chezmoi ]]
  [[ -z $(find "$installer_root/outside" -mindepth 1 -maxdepth 1 -print -quit) ]]
)

