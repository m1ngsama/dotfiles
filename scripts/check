check_theme() {
  python3 - <<'PY'
import hashlib
import json
import math
import pathlib
import re
import tomllib

manifest = tomllib.loads(
    pathlib.Path("theme/solarized-osaka.toml").read_text(encoding="utf-8")
)
lock = json.loads(
    pathlib.Path("home/dot_config/nvim/lazy-lock.json").read_text(encoding="utf-8")
)
if manifest["revision"] != lock["solarized-osaka.nvim"]["commit"]:
    raise SystemExit("theme manifest revision does not match the Neovim lock")
required_provenance = {
    "name",
    "source",
    "revision",
    "license",
    "license_path",
    "license_sha256",
}
missing_provenance = required_provenance - manifest.keys()
if missing_provenance:
    raise SystemExit(f"theme manifest is missing provenance fields: {sorted(missing_provenance)}")
if manifest["license"] != "Apache-2.0":
    raise SystemExit("Solarized Osaka must retain its Apache-2.0 license")
if manifest["source"] != "https://github.com/craftzdog/solarized-osaka.nvim":
    raise SystemExit("theme manifest source does not match the configured plugin")
theme_spec = pathlib.Path(
    "home/dot_config/nvim/lua/plugins/colorscheme.lua"
).read_text(encoding="utf-8")
if '"craftzdog/solarized-osaka.nvim"' not in theme_spec:
    raise SystemExit("configured Neovim theme no longer matches the manifest source")
if manifest["license_path"] != "third_party/solarized-osaka/LICENSE":
    raise SystemExit("theme license path must remain a repository-relative vendor path")
license_path = pathlib.Path(manifest["license_path"])
if not license_path.is_file():
    raise SystemExit(f"theme license is missing: {license_path}")
license_sha256 = hashlib.sha256(license_path.read_bytes()).hexdigest()
if license_sha256 != manifest["license_sha256"]:
    raise SystemExit(
        f"theme license checksum mismatch: expected {manifest['license_sha256']}, "
        f"found {license_sha256}"
    )

primary = manifest["primary"]
ansi = manifest["ansi"]
ui = manifest["ui"]
for section in (primary, ansi, ui):
    for name, value in section.items():
        if name == "opacity":
            continue
        if not re.fullmatch(r"#[0-9a-f]{6}", value):
            raise SystemExit(f"invalid normalized theme color: {name}={value}")

alacritty = tomllib.loads(
    pathlib.Path("home/dot_config/alacritty/alacritty.toml").read_text(encoding="utf-8")
)
if alacritty["colors"]["primary"] != {
    "background": primary["background"],
    "foreground": primary["foreground"],
}:
    raise SystemExit("Alacritty primary colors drifted from the manifest")
if alacritty["colors"]["normal"] != ansi or alacritty["colors"]["bright"] != ansi:
    raise SystemExit("Alacritty ANSI colors drifted from the manifest")
if alacritty["window"]["opacity"] != primary["opacity"]:
    raise SystemExit("Alacritty opacity drifted from the manifest")
if alacritty["colors"]["transparent_background_colors"] is not False:
    raise SystemExit("Alacritty must blend only its primary background")

revision = manifest["revision"]
paths = (
    pathlib.Path("home/dot_config/alacritty/alacritty.toml"),
    pathlib.Path("home/dot_config/tmux/theme.conf"),
    pathlib.Path("home/dot_config/fish/functions/fish_prompt.fish"),
    pathlib.Path("home/dot_config/i3/config"),
)
texts = {path: path.read_text(encoding="utf-8") for path in paths}
for path, text in texts.items():
    if revision not in text:
        raise SystemExit(f"{path} does not identify the palette revision")

fish_expected = {name: value.removeprefix("#") for name, value in ansi.items()}
fish_actual = dict(
    re.findall(
        r"^\s*set -l osaka_([a-z0-9]+) ([0-9a-f]{6})$",
        texts[pathlib.Path("home/dot_config/fish/functions/fish_prompt.fish")],
        re.MULTILINE,
    )
)
for name in ("red", "green", "yellow", "blue", "magenta", "cyan"):
    if fish_actual.get(name) != fish_expected[name]:
        raise SystemExit(f"Fish prompt color drifted: {name}")

i3_expected = {
    "bg": primary["background"],
    "surface": ui["surface"],
    "base02": ui["base02"],
    "base01": ui["base01"],
    "fg": primary["foreground"],
    "base0": ui["base0"],
    "white": ui["white"],
    "yellow": ansi["yellow"],
    "red": ansi["red"],
    "blue": ansi["blue"],
    "cyan": ansi["cyan"],
}
i3_actual = dict(
    re.findall(
        r"^set \$osaka_([a-z0-9]+) (#[0-9a-f]{6})$",
        texts[pathlib.Path("home/dot_config/i3/config")],
        re.MULTILINE,
    )
)
if i3_actual != i3_expected:
    raise SystemExit("i3 palette variables drifted from the manifest")

tmux_text = texts[pathlib.Path("home/dot_config/tmux/theme.conf")]
allowed_tmux_colors = {
    primary["background"],
    primary["foreground"],
    *ansi.values(),
    *ui.values(),
}
unknown_tmux_colors = set(re.findall(r"#[0-9a-f]{6}\b", tmux_text)) - allowed_tmux_colors
if unknown_tmux_colors:
    raise SystemExit(f"tmux contains colors outside the manifest: {unknown_tmux_colors}")
tmux_values = {}
for line in tmux_text.splitlines():
    match = re.match(r"^set-(?:window-)?option -g ([^ ]+) '([^']*)'$", line)
    if match:
        tmux_values[match.group(1)] = match.group(2)
expected_tmux_values = {
    "mode-style": f"fg={primary['background']},bg={ansi['cyan']},bold",
    "message-style": f"fg={ui['base2']},bg={ui['surface']}",
    "message-command-style": f"fg={primary['background']},bg={ansi['yellow']},bold",
    "pane-border-style": f"fg={ui['surface']},bg=default",
    "pane-active-border-style": f"fg={ansi['blue']},bg=default",
    "window-status-style": f"fg={primary['foreground']},bg={primary['background']}",
    "window-status-current-style": f"fg={primary['background']},bg={ansi['blue']},bold",
    "window-status-activity-style": f"fg={ansi['cyan']},bg={primary['background']},underscore",
    "window-status-bell-style": f"fg={ui['white']},bg={ansi['red']},bold",
}
for option, expected in expected_tmux_values.items():
    if tmux_values.get(option) != expected:
        raise SystemExit(f"tmux {option} drifted from the manifest")
active_red_lines = [
    line for line in tmux_text.splitlines()
    if ansi["red"] in line and not line.lstrip().startswith("#")
]
if len(active_red_lines) != 1 or "window-status-bell-style" not in active_red_lines[0]:
    raise SystemExit("tmux must reserve red for its bell state")

def relative_luminance(color):
    channels = [int(color[index:index + 2], 16) / 255 for index in (1, 3, 5)]
    channels = [
        value / 12.92 if value <= 0.04045 else ((value + 0.055) / 1.055) ** 2.4
        for value in channels
    ]
    return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2]

def contrast(left, right):
    high, low = sorted((relative_luminance(left), relative_luminance(right)), reverse=True)
    return (high + 0.05) / (low + 0.05)

pairs = {
    "terminal foreground": (primary["foreground"], primary["background"]),
    "tmux message": (ui["base2"], ui["surface"]),
    "yellow accent": (ansi["yellow"], primary["background"]),
    "blue accent": (ansi["blue"], primary["background"]),
    "cyan accent": (ansi["cyan"], primary["background"]),
    "inactive text": (ui["base0"], ui["surface"]),
    "urgent text": (ui["white"], ansi["red"]),
}
for label, colors in pairs.items():
    ratio = contrast(*colors)
    if not math.isfinite(ratio) or ratio < 4.5:
        raise SystemExit(f"theme contrast below 4.5:1 for {label}: {ratio:.2f}")
PY
}

check_nvm_vendor() {
  python3 - <<'PY'
import hashlib
import pathlib
import tomllib

metadata_path = pathlib.Path("third_party/nvm.fish/UPSTREAM.toml")
metadata = tomllib.loads(metadata_path.read_text(encoding="utf-8"))
required = (
    "name",
    "version",
    "source",
    "revision",
    "license",
    "license_path",
    "license_sha256",
)
for key in required:
    if not isinstance(metadata.get(key), str) or not metadata[key]:
        raise SystemExit(f"nvm.fish metadata is missing {key}")
if len(metadata["revision"]) != 40 or len(metadata["license_sha256"]) != 64:
    raise SystemExit("nvm.fish revision or license SHA-256 has an invalid length")
files = metadata.get("files")
if not isinstance(files, dict) or len(files) != 7:
    raise SystemExit("UPSTREAM.toml must describe exactly 7 nvm.fish files")

for relative, expected in sorted(files.items()):
    relative_path = pathlib.Path(relative)
    if (
        relative_path.is_absolute()
        or ".." in relative_path.parts
        or relative_path.parts[:3] != ("home", "dot_config", "fish")
    ):
        raise SystemExit(f"unsafe nvm.fish metadata path: {relative}")

    source_path = relative_path
    if not source_path.is_file():
        raise SystemExit(f"missing vendored nvm.fish file: {source_path}")
    actual = hashlib.sha256(source_path.read_bytes()).hexdigest()
    if actual != expected:
        raise SystemExit(
            f"nvm.fish checksum mismatch for {source_path}: "
            f"expected {expected}, got {actual}"
        )

license_path = pathlib.Path(metadata["license_path"])
if license_path.is_absolute() or ".." in license_path.parts or not license_path.is_file():
    raise SystemExit(f"missing or unsafe nvm.fish license path: {license_path}")
actual_license = hashlib.sha256(license_path.read_bytes()).hexdigest()
if actual_license != metadata["license_sha256"]:
    raise SystemExit(
        f"nvm.fish license checksum mismatch: expected {metadata['license_sha256']}, "
        f"got {actual_license}"
    )
PY
}

check_ranger_vendor() {
  python3 - <<'PY'
import hashlib
import pathlib
import tomllib

metadata_path = pathlib.Path("third_party/ranger-scope/UPSTREAM.toml")
metadata = tomllib.loads(metadata_path.read_text(encoding="utf-8"))
deployed = metadata.get("deployed", {})
required = (
    "name",
    "version",
    "source",
    "revision",
    "upstream_path",
    "upstream_sha256",
    "license",
    "license_path",
    "license_sha256",
)
for key in required:
    if not isinstance(metadata.get(key), str) or not metadata[key]:
        raise SystemExit(f"ranger scope metadata is missing {key}")
if len(metadata["revision"]) != 40 or len(metadata["upstream_sha256"]) != 64:
    raise SystemExit("ranger scope revision or upstream SHA-256 has an invalid length")
modifications = metadata.get("modifications")
if not isinstance(modifications, list) or not modifications or not all(
    isinstance(item, str) and item for item in modifications
):
    raise SystemExit("ranger scope modifications must be a non-empty string list")
checks = {
    deployed.get("path"): deployed.get("sha256"),
    metadata.get("license_path"): metadata.get("license_sha256"),
}

for relative, expected in checks.items():
    if not isinstance(relative, str) or not isinstance(expected, str):
        raise SystemExit("ranger scope metadata is missing a path or SHA-256")
    relative_path = pathlib.Path(relative)
    if relative_path.is_absolute() or ".." in relative_path.parts:
        raise SystemExit(f"unsafe ranger scope metadata path: {relative}")
    if not relative_path.is_file():
        raise SystemExit(f"missing ranger scope provenance file: {relative_path}")
    actual = hashlib.sha256(relative_path.read_bytes()).hexdigest()
    if actual != expected:
        raise SystemExit(
            f"ranger scope checksum mismatch for {relative_path}: "
            f"expected {expected}, got {actual}"
        )
PY
}

