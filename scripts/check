#!/usr/bin/env bash

set -uo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root" || exit 1
# shellcheck disable=SC1091
source "$repo_root/scripts/lib/safety.bash"

failures=0
skips=0
strict=${DOTFILES_CHECK_STRICT:-0}

pass() {
  printf 'ok   %s\n' "$1"
}

fail() {
  printf 'FAIL %s\n' "$1" >&2
  failures=$((failures + 1))
}

skip() {
  printf 'skip %s\n' "$1"
  skips=$((skips + 1))
}

have() {
  command -v "$1" >/dev/null 2>&1
}

run() {
  local description=$1
  local status
  shift

  # Invoke outside an if/&& conditional so a check's own `set -e` remains
  # effective. Bash otherwise disables errexit throughout called functions.
  "$@"
  status=$?
  if ((status == 0)); then
    pass "$description"
  else
    fail "$description"
  fi
  return 0
}

optional() {
  local command_name=$1
  local description=$2
  shift 2

  if have "$command_name"; then
    run "$description" "$@"
  elif [[ $strict == 1 ]]; then
    fail "$description (missing: $command_name)"
  else
    skip "$description (missing: $command_name)"
  fi
}

check_no_personal_paths() {
  local output

  if ! have rg; then
    return 127
  fi

  output=$(rg -n --hidden \
    --glob '!.git/**' \
    '(^|[^[:alnum:]_}])\/(Users|home)\/[[:alnum:]_.-]+\/' . 2>/dev/null) || {
    local status=$?
    [[ $status == 1 ]] && return 0
    return "$status"
  }

  printf '%s\n' "$output" >&2
  return 1
}

check_repository_whitespace() {
  git diff --check || return 1
  git diff --cached --check || return 1

  python3 - <<'PY'
import os
import pathlib
import subprocess

listed = subprocess.run(
    ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
    check=True,
    stdout=subprocess.PIPE,
).stdout
problems = []

for encoded in listed.split(b"\0"):
    if not encoded:
        continue
    relative = os.fsdecode(encoded)
    path = pathlib.Path(relative)
    if path.is_symlink() or not path.is_file():
        continue
    data = path.read_bytes()
    if b"\0" in data:
        continue
    for number, line in enumerate(data.splitlines(keepends=True), start=1):
        body = line.rstrip(b"\r\n")
        if body.endswith((b" ", b"\t")):
            problems.append(f"{relative}:{number}: trailing whitespace")
    if data and not data.endswith(b"\n"):
        problems.append(f"{relative}: missing final newline")

if problems:
    raise SystemExit("\n".join(problems))
PY
}

check_fish() {
  local file
  local -a files=()

  while IFS= read -r -d '' file; do
    files+=("$file")
  done < <(find home/dot_config/fish -type f -name '*.fish' -print0 | LC_ALL=C sort -z)

  if ((${#files[@]} != 14)); then
    printf 'expected 14 Fish files, found %d\n' "${#files[@]}" >&2
    return 1
  fi

  for file in "${files[@]}"; do
    fish -n "$file" || return 1
  done
}

check_fish_format() {
  local -a owned_files=(
    home/dot_config/fish/config.fish
    home/dot_config/fish/conf.d/00_xdg_defaults.fish
    home/dot_config/fish/conf.d/eza.fish
    home/dot_config/fish/conf.d/m1ng_ghq_key_bindings.fish
    home/dot_config/fish/conf.d/zoxide.fish
    home/dot_config/fish/functions/__m1ng_ghq_repository_search.fish
    home/dot_config/fish/functions/fish_prompt.fish
  )

  # nvm.fish is pinned third-party source. Check its syntax, but never rewrite
  # or enforce local formatting on it.
  fish_indent --check "${owned_files[@]}"
}

check_fish_xdg_defaults() (
  set -euo pipefail

  local fish_parent
  local fish_root

  fish_parent=${TMPDIR:-/tmp}
  fish_parent=$(cd -P -- "$fish_parent" && pwd -P)
  fish_root=$(mktemp -d "$fish_parent/dotfiles-fish.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$fish_root" "$fish_parent" dotfiles-fish.' EXIT HUP INT TERM
  mkdir -p -- "$fish_root/home"
  cd "$fish_root"

  # Fish expands these variables inside its own single-quoted command.
  # shellcheck disable=SC2016
  env -i \
    HOME="$fish_root/home" \
    PATH="$PATH" \
    DOTFILES_REPO_ROOT="$repo_root" \
    XDG_CONFIG_HOME= \
    XDG_DATA_HOME=relative/data \
    XDG_STATE_HOME=relative/state \
    XDG_CACHE_HOME= \
    fish --no-config -c '
      source "$DOTFILES_REPO_ROOT/home/dot_config/fish/conf.d/00_xdg_defaults.fish"
      test "$XDG_CONFIG_HOME" = "$HOME/.config"
      and test "$XDG_DATA_HOME" = "$HOME/.local/share"
      and test "$XDG_STATE_HOME" = "$HOME/.local/state"
      and test "$XDG_CACHE_HOME" = "$HOME/.cache"
      and source "$DOTFILES_REPO_ROOT/home/dot_config/fish/conf.d/nvm.fish"
      and test "$nvm_data" = "$HOME/.local/share/nvm"
    '
)

check_legacy_fish_manifest() {
  python3 - <<'PY'
import pathlib

manifest = pathlib.Path("scripts/legacy-fish-paths")
paths = manifest.read_text(encoding="utf-8").splitlines()
if len(paths) != 96 or paths != sorted(set(paths)):
    raise SystemExit("legacy Fish manifest must contain 96 sorted unique paths")
if ".config/fish/fish_variables" in paths:
    raise SystemExit("mutable fish_variables must never be in the automatic cleanup manifest")

current_root = pathlib.Path("home/dot_config/fish")
current = {
    ".config/fish/" + path.relative_to(current_root).as_posix()
    for path in current_root.rglob("*")
    if path.is_file()
}
for relative in paths:
    path = pathlib.PurePosixPath(relative)
    if path.is_absolute() or ".." in path.parts or path.parts[:2] != (".config", "fish"):
        raise SystemExit(f"unsafe legacy Fish path: {relative}")
    if relative in current:
        raise SystemExit(f"legacy Fish path overlaps current source state: {relative}")
PY
}

check_fish_go_path() (
  set -euo pipefail

  local fish_executable
  local fish_parent
  local fish_root
  local fish_home
  local first_gopath
  local second_gopath
  local gobin

  fish_executable=$(command -v fish)
  [[ $fish_executable == /* ]]

  fish_parent=${TMPDIR:-/tmp}
  fish_parent=$(cd -P -- "$fish_parent" && pwd -P)
  fish_root=$(mktemp -d "$fish_parent/dotfiles-fish-go.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$fish_root" "$fish_parent" dotfiles-fish-go.' EXIT HUP INT TERM

  fish_home="$fish_root/home"
  first_gopath="$fish_root/go-first"
  second_gopath="$fish_root/go-second"
  gobin="$fish_root/gobin"
  mkdir -p -- \
    "$fish_home/go/bin" \
    "$first_gopath/bin" \
    "$second_gopath/bin" \
    "$gobin"

  # --no-config excludes host integrations; fish_add_path records its global
  # additions in fish_user_paths, which normal Fish startup projects into PATH.
  # Fish expands these variables inside its own single-quoted command.
  # shellcheck disable=SC2016
  env -i \
    HOME="$fish_home" \
    PATH="$PATH" \
    DOTFILES_REPO_ROOT="$repo_root" \
    GOBIN="$gobin" \
    GOPATH="$first_gopath:$second_gopath" \
    "$fish_executable" --no-config -c '
      source "$DOTFILES_REPO_ROOT/home/dot_config/fish/config.fish"
      test (count $GOPATH) -eq 2
      and contains -- "$GOBIN" $fish_user_paths
      and not contains -- "$GOPATH[1]/bin" $fish_user_paths
      and not contains -- "$GOPATH[2]/bin" $fish_user_paths
    ' || return 1

  # shellcheck disable=SC2016
  env -i \
    HOME="$fish_home" \
    PATH="$PATH" \
    DOTFILES_REPO_ROOT="$repo_root" \
    GOBIN= \
    GOPATH="$first_gopath:$second_gopath" \
    "$fish_executable" --no-config -c '
      source "$DOTFILES_REPO_ROOT/home/dot_config/fish/config.fish"
      test (count $GOPATH) -eq 2
      and contains -- "$GOPATH[1]/bin" $fish_user_paths
      and not contains -- "$GOPATH[2]/bin" $fish_user_paths
    ' || return 1

  # shellcheck disable=SC2016
  env -i \
    HOME="$fish_home" \
    PATH="$PATH" \
    DOTFILES_REPO_ROOT="$repo_root" \
    GOBIN=relative/bin \
    GOPATH= \
    "$fish_executable" --no-config -c '
      source "$DOTFILES_REPO_ROOT/home/dot_config/fish/config.fish"
      contains -- "$HOME/go/bin" $fish_user_paths
    ' || return 1
)

check_fish_prompt_behavior() (
  set -euo pipefail

  local prompt_parent
  local prompt_root
  local prompt_home
  local prompt_repo
  local prompt_outside
  local prompt_file
  local prompt_command
  local prompt_template
  local output
  local blob
  local detached

  prompt_parent=${TMPDIR:-/tmp}
  prompt_parent=$(cd -P -- "$prompt_parent" && pwd -P)
  prompt_root=$(mktemp -d "$prompt_parent/dotfiles-fish-prompt.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$prompt_root" "$prompt_parent" dotfiles-fish-prompt.' EXIT HUP INT TERM

  prompt_home="$prompt_root/home"
  prompt_repo="$prompt_root/repo"
  prompt_outside="$prompt_root/outside"
  prompt_file="$repo_root/home/dot_config/fish/functions/fish_prompt.fish"
  prompt_template="$prompt_root/git-template"
  # Fish, not Bash, expands the two environment variables in this command.
  # shellcheck disable=SC2016
  prompt_command='cd "$DOTFILES_PROMPT_DIR"; source "$DOTFILES_PROMPT_FILE"; fish_prompt'
  mkdir -p -- "$prompt_home" "$prompt_repo" "$prompt_outside" "$prompt_template"

  unset \
    GIT_COMMON_DIR \
    GIT_CONFIG \
    GIT_CONFIG_COUNT \
    GIT_CONFIG_PARAMETERS \
    GIT_DIR \
    GIT_INDEX_FILE \
    GIT_OBJECT_DIRECTORY \
    GIT_WORK_TREE
  export GIT_ATTR_NOSYSTEM=1
  export GIT_CONFIG_GLOBAL=/dev/null
  export GIT_CONFIG_NOSYSTEM=1
  export GIT_NO_REPLACE_OBJECTS=1
  export GIT_TERMINAL_PROMPT=0
  export GIT_CONFIG_COUNT=3
  export GIT_CONFIG_KEY_0=core.hooksPath
  export GIT_CONFIG_VALUE_0=/dev/null
  export GIT_CONFIG_KEY_1=core.fsmonitor
  export GIT_CONFIG_VALUE_1=false
  export GIT_CONFIG_KEY_2=core.attributesFile
  export GIT_CONFIG_VALUE_2=/dev/null

  git -C "$prompt_repo" -c init.defaultBranch=benchmark \
    init --quiet --template="$prompt_template"
  git -C "$prompt_repo" \
    -c user.name='Dotfiles prompt test' \
    -c user.email=prompt-test@example.invalid \
    -c commit.gpgsign=false \
    commit --quiet --allow-empty --no-verify -m baseline

  output=$(env \
    HOME="$prompt_home" \
    TERM=dumb \
    DOTFILES_PROMPT_DIR="$prompt_outside" \
    DOTFILES_PROMPT_FILE="$prompt_file" \
    fish --no-config -c "$prompt_command")
  [[ $output != *' git:('* ]]

  output=$(env \
    HOME="$prompt_home" \
    TERM=dumb \
    DOTFILES_PROMPT_DIR="$prompt_repo" \
    DOTFILES_PROMPT_FILE="$prompt_file" \
    fish --no-config -c "$prompt_command")
  [[ $output == *' git:(benchmark)'* && $output != *' * '* ]]

  blob=$(printf 'staged change\n' | git -C "$prompt_repo" hash-object -w --stdin)
  git -C "$prompt_repo" update-index --add --cacheinfo "100644,$blob,tracked"
  output=$(env \
    HOME="$prompt_home" \
    TERM=dumb \
    DOTFILES_PROMPT_DIR="$prompt_repo" \
    DOTFILES_PROMPT_FILE="$prompt_file" \
    fish --no-config -c "$prompt_command")
  [[ $output == *' git:(benchmark) *'* ]]

  git -C "$prompt_repo" checkout --quiet --detach
  detached=$(git -C "$prompt_repo" rev-parse --short=7 HEAD)
  output=$(env \
    HOME="$prompt_home" \
    TERM=dumb \
    DOTFILES_PROMPT_DIR="$prompt_repo" \
    DOTFILES_PROMPT_FILE="$prompt_file" \
    fish --no-config -c "$prompt_command")
  [[ $output == *" git:($detached) *"* ]]
)

check_performance_benchmark() (
  set -euo pipefail

  local output
  output=$(
    "$repo_root/scripts/benchmark" \
      --samples 1 \
      --warmups 0 \
      --nvim-samples 1
  )

  grep -Fq 'Fish core startup:' <<<"$output"
  grep -Fq 'Fish configured startup:' <<<"$output"
  grep -Fq 'Prompt outside Git:' <<<"$output"
  grep -Fq 'Prompt in small Git repo:' <<<"$output"
  grep -Fq 'Prompt in 5k-file repo:' <<<"$output"
  grep -Fq 'Active configured Fish integrations:' <<<"$output"
  grep -Fq 'No absolute pass/fail budget is applied.' <<<"$output"
)

check_lua() {
  local file

  while IFS= read -r -d '' file; do
    luac -p "$file" || return 1
  done < <(find home/dot_config/nvim -type f -name '*.lua' -print0)
  luac -p scripts/nvim-first-start.lua
  luac -p scripts/nvim-preflight.lua
}

check_hsl_colors() {
  lua - <<'LUA'
local hsl = dofile("home/dot_config/nvim/lua/m1ngsama/hsl.lua")

local function assert_close(actual, expected)
  assert(math.abs(actual - expected) < 1e-12, ("expected %s, got %s"):format(expected, actual))
end

local short = hsl.hex_to_rgb("#abc")
assert_close(short[1], 170 / 255)
assert_close(short[2], 187 / 255)
assert_close(short[3], 204 / 255)
assert(hsl.hexToHSL("#fff") == "hsl(0, 0, 100)")
assert(hsl.hexToHSL("#ff0000") == "hsl(0, 100, 50)")
assert(hsl.hslToHex(0, 100, 50) == "#ff0000")

local line = "short=#abc long=#112233 alpha=#11223344 malformed=#12 identifier=#abcdefg"
local expected = "short=hsl(210, 25, 73) long=hsl(210, 50, 13) alpha=#11223344 malformed=#12 identifier=#abcdefg"
assert(hsl.replace_hex_colors(line) == expected)

for _, invalid in ipairs({ "#12", "#1234", "#1234567", "#12345678", "not-a-color" }) do
  assert(not pcall(hsl.hex_to_rgb, invalid), "unexpectedly accepted " .. invalid)
end
LUA
}

check_nvim_api() {
  DOTFILES_REPO_ROOT="$repo_root" nvim --clean --headless -u NONE \
    --cmd 'lua local version = vim.version(); assert(version.major > 0 or version.minor >= 12)' \
    --cmd 'lua local hsl = dofile(vim.env.DOTFILES_REPO_ROOT .. "/" .. "home/dot_config/nvim/lua/m1ngsama/hsl.lua"); assert(hsl.hexToHSL("#fff") == "hsl(0, 0, 100)")' \
    --cmd 'lua local spec = dofile(vim.env.DOTFILES_REPO_ROOT .. "/" .. "home/dot_config/nvim/lua/plugins/treesitter.lua"); spec[1].init(); assert(vim.filetype.match({ filename = "test.mdx" }) == "mdx")' \
    --cmd 'lua local original = vim.uv.os_uname; vim.uv.os_uname = function() return { sysname = "Linux", machine = "aarch64" } end; local spec = dofile(vim.env.DOTFILES_REPO_ROOT .. "/" .. "home/dot_config/nvim/lua/plugins/lsp.lua"); vim.uv.os_uname = original; local mason = { ensure_installed = {} }; spec[1].opts(nil, mason); assert(not vim.tbl_contains(mason.ensure_installed, "selene")); assert(not vim.tbl_contains(mason.ensure_installed, "clangd")); local lint = { linters_by_ft = {} }; spec[2].opts(nil, lint); assert(vim.deep_equal(lint.linters_by_ft.lua, { "luacheck" })); assert(spec[3].opts.servers.clangd.mason == false)' \
    --cmd 'lua local lsp = dofile(vim.env.DOTFILES_REPO_ROOT .. "/" .. "home/dot_config/nvim/lua/m1ngsama/lsp.lua"); lsp.toggleInlayHints()' \
    +qa
}

check_nvim_setup_lock_and_signal() (
  set -euo pipefail

  local setup_parent
  local setup_root
  local fake_bin
  local owner_state
  local owner_home
  local owner_events
  local owner_mkdir_marker
  local owner_mkdir_release
  local owner_marker
  local owner_release
  local owner_log
  local contender_log
  local owner_lock
  local owner_pid=
  local owner_status
  local contender_pid=
  local contender_status
  local term_state
  local term_home
  local term_events
  local term_marker
  local term_release
  local term_log
  local term_lock
  local term_pid=
  local term_status
  local term_child_pid
  local real_mkdir

  wait_for_setup_marker() {
    local marker=$1
    local pid=$2
    local count

    for ((count = 0; count < 300; count++)); do
      [[ -e $marker ]] && return 0
      kill -0 "$pid" 2>/dev/null || return 1
      sleep 0.1
    done
    return 1
  }

  # shellcheck disable=SC2317,SC2329
  cleanup_nvim_setup_test() {
    local pid
    local marker
    local child_pid

    for pid in "$owner_pid" "$contender_pid" "$term_pid"; do
      [[ -n $pid ]] || continue
      kill -TERM "$pid" 2>/dev/null || true
    done
    [[ -z $owner_mkdir_release ]] || : >"$owner_mkdir_release"
    [[ -z $owner_release ]] || : >"$owner_release"
    for pid in "$owner_pid" "$contender_pid" "$term_pid"; do
      [[ -n $pid ]] || continue
      wait "$pid" 2>/dev/null || true
    done
    for marker in "$owner_marker" "$term_marker"; do
      [[ -f $marker ]] || continue
      child_pid=$(<"$marker")
      [[ $child_pid =~ ^[0-9]+$ ]] || continue
      kill -TERM "$child_pid" 2>/dev/null || true
    done
    dotfiles_safe_cleanup_tree "$setup_root" "$setup_parent" dotfiles-nvim-setup-test.
  }

  # shellcheck disable=SC2317,SC2329
  exit_nvim_setup_test_for_signal() {
    local status=$1

    trap - HUP INT TERM
    cleanup_nvim_setup_test
    trap - EXIT
    exit "$status"
  }

  setup_parent=${TMPDIR:-/tmp}
  setup_parent=$(cd -P -- "$setup_parent" && pwd -P)
  real_mkdir=$(command -v mkdir)
  [[ $real_mkdir == /* ]]
  setup_root=$(mktemp -d "$setup_parent/dotfiles-nvim-setup-test.XXXXXXXX")
  fake_bin="$setup_root/bin"
  owner_state="$setup_root/owner-state"
  owner_home="$setup_root/owner-home"
  owner_events="$setup_root/owner-events"
  owner_mkdir_marker="$setup_root/owner-lock-created"
  owner_mkdir_release="$setup_root/owner-lock-release"
  owner_marker="$setup_root/owner-preflight-child"
  owner_release="$setup_root/owner-release"
  owner_log="$setup_root/owner.log"
  contender_log="$setup_root/contender.log"
  owner_lock="$owner_state/nvim/dotfiles-setup.lock"
  term_state="$setup_root/term-state"
  term_home="$setup_root/term-home"
  term_events="$setup_root/term-events"
  term_marker="$setup_root/term-preflight-child"
  term_release="$setup_root/term-release"
  term_log="$setup_root/term.log"
  term_lock="$term_state/nvim/dotfiles-setup.lock"
  mkdir -p -- "$fake_bin" "$owner_home" "$term_home"
  : >"$owner_events"
  : >"$term_events"

  trap cleanup_nvim_setup_test EXIT
  trap 'exit_nvim_setup_test_for_signal 129' HUP
  trap 'exit_nvim_setup_test_for_signal 130' INT
  trap 'exit_nvim_setup_test_for_signal 143' TERM

  # This fake never loads configuration or accesses the network. A preflight
  # records its child PID and blocks until released. If a locking regression
  # lets a second setup reach preflight, it records that violation and exits
  # immediately instead of making the test hang.
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'is_preflight=0' \
    'for argument in "$@"; do' \
    '  [[ $argument != --clean ]] || is_preflight=1' \
    'done' \
    'if ((is_preflight == 0)); then' \
    '  printf "provision\\t%s\\n" "$$" >>"$DOTFILES_TEST_EVENTS"' \
    '  exit 0' \
    'fi' \
    'printf "preflight\\t%s\\n" "$$" >>"$DOTFILES_TEST_EVENTS"' \
    'if [[ -e $DOTFILES_TEST_MARKER ]]; then' \
    '  exit 91' \
    'fi' \
    'printf "%s\\n" "$$" >"$DOTFILES_TEST_MARKER"' \
    'on_term() {' \
    '  printf "child-term\\t%s\\n" "$$" >>"$DOTFILES_TEST_EVENTS"' \
    '  exit 143' \
    '}' \
    'trap on_term TERM' \
    'for ((index = 0; index < 300; index++)); do' \
    '  [[ ! -e $DOTFILES_TEST_RELEASE ]] || exit 0' \
    '  sleep 0.1' \
    'done' \
    'exit 124' \
    >"$fake_bin/nvim"
  chmod 0755 "$fake_bin/nvim"

  # Reproduce the narrow ownership window exactly: the real mkdir has created
  # an empty setup lock, but setup-nvim has not yet observed success, marked
  # lock_owned, or written its PID. A losing contender's EXIT cleanup must not
  # remove that empty directory from underneath the owner.
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'is_setup_lock=0' \
    'for argument in "$@"; do' \
    '  case $argument in' \
    '    */dotfiles-setup.lock) is_setup_lock=1 ;;' \
    '  esac' \
    'done' \
    '"$DOTFILES_TEST_REAL_MKDIR" "$@"' \
    'status=$?' \
    '((status == 0)) || exit "$status"' \
    'if ((is_setup_lock == 1)) && [[ -n ${DOTFILES_TEST_MKDIR_MARKER:-} ]]; then' \
    '  : >"$DOTFILES_TEST_MKDIR_MARKER"' \
    '  for ((index = 0; index < 300; index++)); do' \
    '    [[ ! -e $DOTFILES_TEST_MKDIR_RELEASE ]] || exit 0' \
    '    sleep 0.1' \
    '  done' \
    '  exit 124' \
    'fi' \
    'exit 0' \
    >"$fake_bin/mkdir"
  chmod 0755 "$fake_bin/mkdir"

  PATH="$fake_bin:$PATH" \
    HOME="$owner_home" \
    XDG_STATE_HOME="$owner_state" \
    DOTFILES_TEST_EVENTS="$owner_events" \
    DOTFILES_TEST_REAL_MKDIR="$real_mkdir" \
    DOTFILES_TEST_MKDIR_MARKER="$owner_mkdir_marker" \
    DOTFILES_TEST_MKDIR_RELEASE="$owner_mkdir_release" \
    DOTFILES_TEST_MARKER="$owner_marker" \
    DOTFILES_TEST_RELEASE="$owner_release" \
    "$repo_root/scripts/setup-nvim" >"$owner_log" 2>&1 &
  owner_pid=$!
  wait_for_setup_marker "$owner_mkdir_marker" "$owner_pid"
  [[ -d $owner_lock && ! -e $owner_lock/pid && ! -L $owner_lock/pid ]]
  [[ -z $(find "$owner_lock" -mindepth 1 -maxdepth 1 -print -quit) ]]
  [[ ! -s $owner_events ]]

  PATH="$fake_bin:$PATH" \
    HOME="$owner_home" \
    XDG_STATE_HOME="$owner_state" \
    DOTFILES_TEST_EVENTS="$owner_events" \
    DOTFILES_TEST_REAL_MKDIR="$real_mkdir" \
    DOTFILES_TEST_MKDIR_MARKER="$owner_mkdir_marker" \
    DOTFILES_TEST_MKDIR_RELEASE="$owner_mkdir_release" \
    DOTFILES_TEST_MARKER="$owner_marker" \
    DOTFILES_TEST_RELEASE="$owner_release" \
    "$repo_root/scripts/setup-nvim" >"$contender_log" 2>&1 &
  contender_pid=$!
  if wait "$contender_pid"; then
    contender_status=0
  else
    contender_status=$?
  fi
  contender_pid=

  [[ $contender_status != 0 ]]
  [[ -d $owner_lock && ! -e $owner_lock/pid && ! -L $owner_lock/pid ]]
  [[ -z $(find "$owner_lock" -mindepth 1 -maxdepth 1 -print -quit) ]]
  [[ ! -s $owner_events ]]
  grep -Fq 'Another Neovim setup may be active' "$contender_log"

  : >"$owner_mkdir_release"
  wait_for_setup_marker "$owner_marker" "$owner_pid"
  [[ -d $owner_lock && -f $owner_lock/pid ]]
  [[ $(<"$owner_lock/pid") == "$owner_pid" ]]
  [[ $(grep -c '^preflight' "$owner_events") == 1 ]]

  : >"$owner_release"
  if wait "$owner_pid"; then
    owner_status=0
  else
    owner_status=$?
  fi
  owner_pid=

  [[ $owner_status == 0 ]]
  [[ $(grep -c '^preflight' "$owner_events") == 1 ]]
  [[ $(grep -c '^provision' "$owner_events") == 1 ]]
  [[ ! -e $owner_lock && ! -L $owner_lock ]]

  PATH="$fake_bin:$PATH" \
    HOME="$term_home" \
    XDG_STATE_HOME="$term_state" \
    DOTFILES_TEST_EVENTS="$term_events" \
    DOTFILES_TEST_REAL_MKDIR="$real_mkdir" \
    DOTFILES_TEST_MARKER="$term_marker" \
    DOTFILES_TEST_RELEASE="$term_release" \
    "$repo_root/scripts/setup-nvim" >"$term_log" 2>&1 &
  term_pid=$!
  wait_for_setup_marker "$term_marker" "$term_pid"
  term_child_pid=$(<"$term_marker")
  [[ $term_child_pid =~ ^[0-9]+$ ]]
  kill -0 "$term_child_pid"
  [[ -d $term_lock && -f $term_lock/pid ]]
  [[ $(<"$term_lock/pid") == "$term_pid" ]]

  kill -TERM "$term_pid"
  if wait "$term_pid"; then
    term_status=0
  else
    term_status=$?
  fi
  term_pid=

  [[ $term_status == 143 ]]
  grep -Fqx $'child-term\t'"$term_child_pid" "$term_events"
  if kill -0 "$term_child_pid" 2>/dev/null; then
    return 1
  fi
  [[ ! -e $term_lock && ! -L $term_lock ]]
  if grep -Fq $'provision\t' "$term_events" ||
    grep -Fq 'Provisioning the reviewed plugin and toolchain graph' "$term_log"; then
    return 1
  fi
)

check_nvim_preflight_integrity() (
  set -euo pipefail

  local preflight_parent
  local preflight_root
  local baseline
  local base_commit
  local config_root
  local lazy_root
  local hook
  local marker
  local preflight_log
  local replacement_commit
  local case_name
  local -a quarantined_cases

  preflight_parent=${TMPDIR:-/tmp}
  preflight_parent=$(cd -P -- "$preflight_parent" && pwd -P)
  preflight_root=$(mktemp -d "$preflight_parent/dotfiles-nvim-preflight.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$preflight_root" "$preflight_parent" dotfiles-nvim-preflight.' EXIT HUP INT TERM

  baseline="$preflight_root/baseline"
  config_root="$preflight_root/config/nvim"
  lazy_root="$preflight_root/data/nvim/lazy"
  hook="$preflight_root/untrusted-filter"
  marker="$preflight_root/untrusted-command-executed"
  preflight_log="$preflight_root/preflight.log"
  quarantined_cases=(
    filter-metadata
    gitlink
    ignored-code
    info-exclude
    replace-ref
    skip-index
    stat-config
    worktree-config
  )

  mkdir -p -- "$baseline" "$config_root" "$lazy_root" "$preflight_root/home"
  git -C "$baseline" init --quiet
  printf 'return { trusted = true }\n' >"$baseline/plugin.lua"
  printf 'build/\n' >"$baseline/.gitignore"
  git -C "$baseline" add -- plugin.lua .gitignore
  git -C "$baseline" \
    -c user.name='dotfiles canary' \
    -c user.email='dotfiles-canary@example.invalid' \
    commit --quiet -m baseline
  base_commit=$(git -C "$baseline" rev-parse HEAD)

  cp -R -- "$baseline" "$lazy_root/control"
  for case_name in "${quarantined_cases[@]}"; do
    cp -R -- "$baseline" "$lazy_root/$case_name"
  done

  mkdir -p -- "$preflight_root/external-worktree"
  cp -- "$baseline/plugin.lua" "$preflight_root/external-worktree/plugin.lua"
  cp -- "$baseline/.gitignore" "$preflight_root/external-worktree/.gitignore"
  git -C "$lazy_root/worktree-config" config core.worktree "$preflight_root/external-worktree"

  # The literal variable is expanded only if an unsafe Git metadata command
  # executes. A safe preflight must quarantine this checkout first.
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/bin/sh' \
    ': >"$DOTFILES_NVIM_PREFLIGHT_MARKER"' \
    'cat' \
    >"$hook"
  chmod 700 "$hook"
  git -C "$lazy_root/filter-metadata" config filter.dotfiles-canary.clean "$hook"
  printf '*.lua filter=dotfiles-canary\n' \
    >"$lazy_root/filter-metadata/.git/info/attributes"
  printf 'return { trusted = false }\n' >"$lazy_root/filter-metadata/plugin.lua"

  printf 'hidden.lua\n' >>"$lazy_root/info-exclude/.git/info/exclude"
  printf 'return { hidden = true }\n' >"$lazy_root/info-exclude/hidden.lua"

  replacement_commit=$(
    printf 'replacement metadata\n' |
      git -C "$lazy_root/replace-ref" \
        -c user.name='dotfiles canary' \
        -c user.email='dotfiles-canary@example.invalid' \
        commit-tree "${base_commit}^{tree}" -p "$base_commit"
  )
  git -C "$lazy_root/replace-ref" replace "$base_commit" "$replacement_commit"

  printf 'return { trusted = false }\n' >"$lazy_root/skip-index/plugin.lua"
  git -C "$lazy_root/skip-index" update-index --skip-worktree plugin.lua

  git -C "$lazy_root/stat-config" config core.trustctime false
  git -C "$lazy_root/stat-config" config core.checkStat minimal

  mkdir -p -- "$lazy_root/ignored-code/build"
  printf 'return { ignored = true }\n' >"$lazy_root/ignored-code/build/plugin.lua"

  git -C "$lazy_root/gitlink" update-index \
    --add --cacheinfo "160000,$base_commit,nested"
  git -C "$lazy_root/gitlink" \
    -c user.name='dotfiles canary' \
    -c user.email='dotfiles-canary@example.invalid' \
    commit --quiet -m gitlink

  DOTFILES_NVIM_PREFLIGHT_LAZY_ROOT="$lazy_root" \
    DOTFILES_NVIM_PREFLIGHT_CONFIG="$config_root/lazy-lock.json" \
    python3 - <<'PY'
import json
import os
import pathlib
import subprocess

root = pathlib.Path(os.environ["DOTFILES_NVIM_PREFLIGHT_LAZY_ROOT"])
lock = {}
for checkout in sorted(path for path in root.iterdir() if path.is_dir()):
    commit = subprocess.check_output(
        ["git", "--no-replace-objects", "-C", str(checkout), "rev-parse", "HEAD"],
        text=True,
    ).strip()
    lock[checkout.name] = {"branch": "main", "commit": commit}
pathlib.Path(os.environ["DOTFILES_NVIM_PREFLIGHT_CONFIG"]).write_text(
    json.dumps(lock, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PY

  env \
    DOTFILES_NVIM_PREFLIGHT_MARKER="$marker" \
    DOTFILES_NVIM_PREFLIGHT_SCRIPT="$repo_root/scripts/nvim-preflight.lua" \
    HOME="$preflight_root/home" \
    NVIM_APPNAME=nvim \
    XDG_CONFIG_HOME="$preflight_root/config" \
    XDG_DATA_HOME="$preflight_root/data" \
    XDG_STATE_HOME="$preflight_root/state" \
    nvim --clean --headless -u NONE \
      '+lua dofile(vim.env.DOTFILES_NVIM_PREFLIGHT_SCRIPT)' +qa \
      >"$preflight_log" 2>&1

  [[ -d $lazy_root/control ]]
  [[ ! -e $marker && ! -L $marker ]]
  for case_name in "${quarantined_cases[@]}"; do
    [[ ! -e $lazy_root/$case_name && ! -L $lazy_root/$case_name ]]
    [[ -n $(find "$preflight_root/data/nvim/dotfiles-quarantine" \
      -mindepth 2 -maxdepth 2 -type d -name "$case_name" -print -quit) ]]
    grep -Fq "Quarantined Neovim plugin $case_name:" "$preflight_log"
  done
)

check_nvim_bootstrap() (
  set -euo pipefail

  local bootstrap_parent
  local bootstrap_root
  local expected_commit
  local expected_lazyvim_commit
  local installed_commit
  local lazy_path
  local lazyvim_path
  local lock_probe
  local nvim_log

  bootstrap_parent=${TMPDIR:-/tmp}
  bootstrap_parent=$(cd -P -- "$bootstrap_parent" && pwd -P)
  bootstrap_root=$(mktemp -d "$bootstrap_parent/dotfiles-nvim-bootstrap.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$bootstrap_root" "$bootstrap_parent" dotfiles-nvim-bootstrap.' EXIT HUP INT TERM

  lazy_path="$bootstrap_root/data/nvim/lazy/lazy.nvim"
  lazyvim_path="$bootstrap_root/data/nvim/lazy/LazyVim"
  lock_probe="$bootstrap_root/lazy-lock.json"
  nvim_log="$bootstrap_root/nvim.log"
  expected_commit=$(jq -er '."lazy.nvim".commit' home/dot_config/nvim/lazy-lock.json)
  expected_lazyvim_commit=$(jq -er '.LazyVim.commit' home/dot_config/nvim/lazy-lock.json)
  printf '{}\n' >"$lock_probe"

  # Exercise the repository's real bootstrap without resolving the full plugin
  # graph. The second process then makes lazy.nvim write a minimal lock so a
  # missing origin/HEAD cannot silently truncate the deployed lock on day one.
  env \
    DOTFILES_REPO_ROOT="$repo_root" \
    NVIM_APPNAME=nvim \
    XDG_CACHE_HOME="$bootstrap_root/cache" \
    XDG_CONFIG_HOME="$bootstrap_root/config" \
    XDG_DATA_HOME="$bootstrap_root/data" \
    XDG_STATE_HOME="$bootstrap_root/state" \
    nvim --clean --headless -u NONE \
      --cmd 'lua package.preload["lazy"] = function() return { setup = function() end } end' \
      --cmd 'lua local ok, err = pcall(dofile, vim.env.DOTFILES_REPO_ROOT .. "/" .. "home/dot_config/nvim/lua/config/lazy.lua"); if not ok then vim.api.nvim_err_writeln(err); vim.cmd("cquit 1") end' \
      +qa >"$nvim_log" 2>&1

  installed_commit=$(git -C "$lazy_path" rev-parse HEAD)
  [[ $installed_commit == "$expected_commit" ]]
  [[ $(git -C "$lazy_path" symbolic-ref refs/remotes/origin/HEAD) == refs/remotes/origin/main ]]
  [[ $(git -C "$lazy_path" rev-parse refs/remotes/origin/main) == "$expected_commit" ]]
  [[ $(git -C "$lazyvim_path" rev-parse HEAD) == "$expected_lazyvim_commit" ]]
  [[ $(git -C "$lazyvim_path" symbolic-ref refs/remotes/origin/HEAD) == refs/remotes/origin/main ]]
  [[ $(git -C "$lazyvim_path" rev-parse refs/remotes/origin/main) == "$expected_lazyvim_commit" ]]

  env \
    DOTFILES_LAZY_PATH="$lazy_path" \
    DOTFILES_LOCK_PROBE="$lock_probe" \
    NVIM_APPNAME=nvim \
    nvim --clean --headless -u NONE \
      --cmd 'lua vim.opt.rtp:prepend(vim.env.DOTFILES_LAZY_PATH)' \
      --cmd 'lua local ok, err = pcall(function() require("lazy").setup({ spec = {{ "folke/lazy.nvim" }}, root = vim.fn.fnamemodify(vim.env.DOTFILES_LAZY_PATH, ":h"), lockfile = vim.env.DOTFILES_LOCK_PROBE, install = { missing = false }, checker = { enabled = false }, change_detection = { enabled = false } }); require("lazy.manage.lock").update() end); if not ok then vim.api.nvim_err_writeln(err); vim.cmd("cquit 1") end' \
      +qa >>"$nvim_log" 2>&1

  jq -e \
    --arg commit "$expected_commit" \
    'keys == ["lazy.nvim"] and ."lazy.nvim" == {"branch":"main", "commit":$commit}' \
    "$lock_probe" >/dev/null
  ! grep -Eq 'E[0-9]{3,}|assertion failed|bootstrap failed' "$nvim_log"
)

check_nvim_first_start() (
  set -euo pipefail

  local canary_parent
  local canary_root
  local drift_marker
  local fsmonitor_hook
  local git_template
  local global_attributes
  local lazy_root
  local lazyvim_init
  local lualine_init
  local nvim_log
  local nvim_error_pattern
  local post_checkout_hook
  local quarantine_root
  local theme_init

  canary_parent=${TMPDIR:-/tmp}
  canary_parent=$(cd -P -- "$canary_parent" && pwd -P)
  canary_root=$(mktemp -d "$canary_parent/dotfiles-nvim-first-start.XXXXXXXX")
  trap 'dotfiles_safe_cleanup_tree "$canary_root" "$canary_parent" dotfiles-nvim-first-start.' EXIT HUP INT TERM

  mkdir -p -- "$canary_root/config" "$canary_root/home" "$canary_root/state"
  cp -R -- home/dot_config/nvim "$canary_root/config/nvim"
  nvim_log="$canary_root/nvim.log"
  lazy_root="$canary_root/data/nvim/lazy"
  quarantine_root="$canary_root/data/nvim/dotfiles-quarantine"
  drift_marker="$canary_root/old-plugin-code-executed"
  fsmonitor_hook="$canary_root/untrusted-fsmonitor"
  git_template="$canary_root/untrusted-git-template"
  global_attributes="$canary_root/untrusted-global-attributes"
  post_checkout_hook="$lazy_root/plenary.nvim/.git/hooks/post-checkout"
  nvim_error_pattern='Package is already installing|Failed to run .(init|config).|installation was aborted|Neovim is exiting while packages are still installing|Terminating all installations|lazy task failed|Mason package .* did not converge|E[0-9]{3,}|bootstrap failed|timed out waiting'

  # A cold clone must not execute content-changing or executable inputs from
  # the caller's personal Git configuration. If setup-nvim fails to install
  # its controlled Git view, this hook/filter both leaves an observable marker
  # and corrupts checked-out Lua, making the canary fail closed.
  mkdir -p -- "$git_template/hooks"
  # The canary expands this variable only when Git invokes it.
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/bin/sh' \
    ': >"$DOTFILES_NVIM_DRIFT_MARKER"' \
    "printf 'canary-token\\n'" \
    >"$fsmonitor_hook"
  chmod 700 "$fsmonitor_hook"
  cp -- "$fsmonitor_hook" "$git_template/hooks/post-checkout"
  chmod 700 "$git_template/hooks/post-checkout"
  printf '*.lua filter=dotfiles-canary\n' >"$global_attributes"
  git config --file "$canary_root/home/.gitconfig" core.hooksPath "$git_template/hooks"
  git config --file "$canary_root/home/.gitconfig" init.templateDir "$git_template"
  git config --file "$canary_root/home/.gitconfig" core.attributesFile "$global_attributes"
  git config --file "$canary_root/home/.gitconfig" filter.dotfiles-canary.clean "$fsmonitor_hook"
  git config --file "$canary_root/home/.gitconfig" filter.dotfiles-canary.smudge "$fsmonitor_hook"

  if ! env \
    DOTFILES_NVIM_DRIFT_MARKER="$drift_marker" \
    DOTFILES_NVIM_PREFLIGHT_SCRIPT=/definitely/missing-preflight.lua \
    DOTFILES_NVIM_SETUP_SCRIPT=/definitely/missing-setup.lua \
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0=core.fsmonitor \
    GIT_CONFIG_VALUE_0=/definitely/missing-fsmonitor \
    GIT_DIR=/definitely/missing-git-dir \
    GIT_INDEX_FILE=/definitely/missing-git-index \
    GIT_TERMINAL_PROMPT=0 \
    GIT_TEMPLATE_DIR=/definitely/missing-git-template \
    GIT_WORK_TREE=/definitely/missing-git-worktree \
    GOFLAGS=-modcacherw \
    HOME="$canary_root/home" \
    NVIM_APPNAME=caller-value-must-not-win \
    XDG_CACHE_HOME="$canary_root/cache" \
    XDG_CONFIG_HOME="$canary_root/config" \
    XDG_DATA_HOME="$canary_root/data" \
    XDG_STATE_HOME="$canary_root/state" \
    "$repo_root/scripts/setup-nvim" \
      >"$nvim_log" 2>&1; then
    tail -n 200 "$nvim_log" >&2
    return 1
  fi

  if [[ -e $drift_marker || -L $drift_marker ]]; then
    printf 'personal Git configuration executed during a cold Neovim clone\n' >&2
    return 1
  fi

  if grep -Eq "$nvim_error_pattern" "$nvim_log"; then
    grep -En "$nvim_error_pattern" "$nvim_log" >&2
    return 1
  fi

  cmp -- \
    home/dot_config/nvim/lazy-lock.json \
    "$canary_root/config/nvim/lazy-lock.json" || return 1

  # Exercise both drift classes before a real config can load them: a clean
  # manager commit mismatch, a clean LazyVim commit containing an observable
  # startup side effect, and a dirty start-plugin checkout with the same side
  # effect. The clean preflight must quarantine all three, preserve them, and
  # let the single normal process install exact locked checkouts.
  git -C "$lazy_root/lazy.nvim" \
    -c user.name='dotfiles canary' \
    -c user.email='dotfiles-canary@example.invalid' \
    commit --quiet --allow-empty -m 'canary manager drift' || return 1

  lazyvim_init="$lazy_root/LazyVim/lua/lazyvim/config/init.lua"
  printf '\nvim.fn.writefile({ "executed" }, vim.env.DOTFILES_NVIM_DRIFT_MARKER)\n' \
    >>"$lazyvim_init"
  git -C "$lazy_root/LazyVim" add -- lua/lazyvim/config/init.lua || return 1
  git -C "$lazy_root/LazyVim" \
    -c user.name='dotfiles canary' \
    -c user.email='dotfiles-canary@example.invalid' \
    commit --quiet -m 'canary LazyVim drift' || return 1

  theme_init="$lazy_root/solarized-osaka.nvim/lua/solarized-osaka/init.lua"
  printf '\nvim.fn.writefile({ "executed" }, vim.env.DOTFILES_NVIM_DRIFT_MARKER)\n' \
    >>"$theme_init"
  git -C "$lazy_root/solarized-osaka.nvim" \
    update-index --skip-worktree lua/solarized-osaka/init.lua || return 1

  lualine_init="$lazy_root/lualine.nvim/lua/lualine.lua"
  printf '\nvim.fn.writefile({ "executed" }, vim.env.DOTFILES_NVIM_DRIFT_MARKER)\n' \
    >>"$lualine_init"
  # Git metadata is outside the worktree. Keep this checkout exact and clean,
  # but give it two executable metadata channels. Preflight must quarantine
  # unsupported metadata before either channel can execute.
  git -C "$lazy_root/plenary.nvim" config core.fsmonitor "$fsmonitor_hook" || return 1
  cp -- "$fsmonitor_hook" "$post_checkout_hook"
  chmod 700 "$post_checkout_hook"

  if ! env \
    DOTFILES_NVIM_DRIFT_MARKER="$drift_marker" \
    GIT_TERMINAL_PROMPT=0 \
    GOFLAGS=-modcacherw \
    HOME="$canary_root/home" \
    NVIM_APPNAME=caller-value-must-not-win \
    XDG_CACHE_HOME="$canary_root/cache" \
    XDG_CONFIG_HOME="$canary_root/config" \
    XDG_DATA_HOME="$canary_root/data" \
    XDG_STATE_HOME="$canary_root/state" \
    "$repo_root/scripts/setup-nvim" \
      >>"$nvim_log" 2>&1; then
    tail -n 200 "$nvim_log" >&2
    return 1
  fi
  if grep -Eq "$nvim_error_pattern" "$nvim_log"; then
    grep -En "$nvim_error_pattern" "$nvim_log" >&2
    return 1
  fi
  if [[ -e $drift_marker || -L $drift_marker ]]; then
    printf 'a drifted Neovim plugin executed before quarantine\n' >&2
    return 1
  fi
  grep -Fq 'Quarantined Neovim plugin lazy.nvim:' "$nvim_log" || return 1
  grep -Fq 'Quarantined Neovim plugin LazyVim:' "$nvim_log" || return 1
  grep -Fq 'Quarantined Neovim plugin lualine.nvim:' "$nvim_log" || return 1
  grep -Fq 'Quarantined Neovim plugin plenary.nvim:' "$nvim_log" || return 1
  grep -Fq 'Quarantined Neovim plugin solarized-osaka.nvim:' "$nvim_log" || return 1
  [[ -n $(find "$quarantine_root" -mindepth 2 -maxdepth 2 -type d -name lazy.nvim -print -quit) ]] || return 1
  [[ -n $(find "$quarantine_root" -mindepth 2 -maxdepth 2 -type d -name LazyVim -print -quit) ]] || return 1
  [[ -n $(find "$quarantine_root" -mindepth 2 -maxdepth 2 -type d -name lualine.nvim -print -quit) ]] || return 1
  [[ -n $(find "$quarantine_root" -mindepth 2 -maxdepth 2 -type d -name plenary.nvim -print -quit) ]] || return 1
  [[ -n $(find "$quarantine_root" -mindepth 2 -maxdepth 2 -type d -name solarized-osaka.nvim -print -quit) ]] || return 1
  [[ ! -e $canary_root/state/nvim/dotfiles-setup.lock ]] || return 1

  cmp -- \
    home/dot_config/nvim/lazy-lock.json \
    "$canary_root/config/nvim/lazy-lock.json" || return 1

  DOTFILES_NVIM_CANARY_ROOT="$canary_root" python3 - <<'PY'
import json
import os
import pathlib
import platform
import subprocess

root = pathlib.Path(os.environ["DOTFILES_NVIM_CANARY_ROOT"])
lock = json.loads(
    pathlib.Path("home/dot_config/nvim/lazy-lock.json").read_text(encoding="utf-8")
)
plugins = root / "data" / "nvim" / "lazy"
missing = []
wrong = []
gitlinks = []
for name, entry in sorted(lock.items()):
    path = plugins / name
    if not path.is_dir():
        missing.append(name)
        continue
    head = subprocess.check_output(
        ["git", "-C", str(path), "rev-parse", "HEAD"], text=True
    ).strip()
    if head != entry["commit"]:
        wrong.append((name, entry["commit"], head))
    staged = subprocess.check_output(
        ["git", "-C", str(path), "ls-files", "-s"], text=True
    ).splitlines()
    if any(line.startswith("160000 ") for line in staged):
        gitlinks.append(name)

if missing or wrong or gitlinks:
    raise SystemExit(
        f"missing plugins: {missing}; wrong plugin commits: {wrong}; "
        f"unverified gitlinks: {gitlinks}"
    )

mason_packages = root / "data" / "nvim" / "mason" / "packages"
package_dirs = sorted(path for path in mason_packages.iterdir() if path.is_dir())
without_receipts = [path.name for path in package_dirs if not (path / "mason-receipt.json").is_file()]
linux_arm64 = platform.system() == "Linux" and platform.machine() in {"aarch64", "arm64"}
expected_packages = 16 if linux_arm64 else 18
if len(package_dirs) != expected_packages or without_receipts:
    raise SystemExit(
        f"expected {expected_packages} complete Mason packages; found {len(package_dirs)}; "
        f"missing receipts: {without_receipts}"
    )
PY
)

check_json() {
  jq empty \
    home/dot_config/nvim/lazy-lock.json \
    home/dot_config/nvim/lazyvim.json
}

check_nvim_lock() {
  python3 - <<'PY'
import json
import pathlib
import re

lock_path = pathlib.Path("home/dot_config/nvim/lazy-lock.json")
lock = json.loads(lock_path.read_text(encoding="utf-8"))
if not isinstance(lock, dict) or len(lock) != 50:
    raise SystemExit(f"expected exactly 50 locked Neovim plugins, found {len(lock)}")

for name, entry in sorted(lock.items()):
    if not isinstance(entry, dict):
        raise SystemExit(f"invalid lock entry for {name}")
    branch = entry.get("branch")
    commit = entry.get("commit")
    if not isinstance(branch, str) or not branch:
        raise SystemExit(f"missing locked branch for {name}")
    if not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise SystemExit(f"invalid locked commit for {name}: {commit}")

if lock["nvim-treesitter"]["branch"] != "main":
    raise SystemExit("the Neovim 0.12 configuration expects nvim-treesitter main")
lazy_bootstrap = pathlib.Path(
    "home/dot_config/nvim/lua/config/lazy.lua"
).read_text(encoding="utf-8")
match = re.search(r'^local lazy_commit = "([0-9a-f]{40})"$', lazy_bootstrap, re.MULTILINE)
if not match or match.group(1) != lock["lazy.nvim"]["commit"]:
    raise SystemExit("lazy.nvim bootstrap commit does not match lazy-lock.json")
lazyvim_match = re.search(r'^local lazyvim_commit = "([0-9a-f]{40})"$', lazy_bootstrap, re.MULTILINE)
if not lazyvim_match or lazyvim_match.group(1) != lock["LazyVim"]["commit"]:
    raise SystemExit("LazyVim bootstrap commit does not match lazy-lock.json")
if "local benchmark = vim.g.dotfiles_benchmark == 1" not in lazy_bootstrap:
    raise SystemExit("Neovim benchmark mode is not declared before lazy setup")
if "install = { missing = not benchmark }" not in lazy_bootstrap:
    raise SystemExit("Neovim benchmark mode no longer disables missing-plugin installation")
if "aerial.nvim" not in lock:
    raise SystemExit("aerial.nvim is configured but missing from the lock")
if "render-markdown.nvim" not in lock:
    raise SystemExit("render-markdown.nvim is configured but missing from the lock")
mason_spec = pathlib.Path(
    "home/dot_config/nvim/lua/plugins/lsp.lua"
).read_text(encoding="utf-8")
if "github:mason-org/mason-registry@2026-08-10-faulty-close" not in mason_spec:
    raise SystemExit("the Mason registry release is not pinned")
treesitter_spec = pathlib.Path(
    "home/dot_config/nvim/lua/plugins/treesitter.lua"
).read_text(encoding="utf-8")
for label, spec in (("Mason", mason_spec), ("Treesitter", treesitter_spec)):
    if "vim.g.dotfiles_benchmark == 1" not in spec or "opts.ensure_installed = {}" not in spec:
        raise SystemExit(f"Neovim benchmark mode no longer disables {label} provisioning")
for stale in (
    "image.nvim",
    "markdown-preview.nvim",
    "nvim-treesitter-playground",
    "symbols-outline.nvim",
):
    if stale in lock:
        raise SystemExit(f"stale Neovim lock entry: {stale}")
PY
}

